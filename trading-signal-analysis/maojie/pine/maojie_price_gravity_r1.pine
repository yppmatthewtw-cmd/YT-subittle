//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  價格重心 (Price Gravity) —— 推論重建猫姐「重心指標」的公開版 r1（r0 因 alertcondition 訊息非常數而無法編譯）
//
//  重心 = 主力成本線的代理：
//     模式 A  當日 VWAP（每個交易日重置）                       → 日內
//     模式 B  錨定 VWAP（每週 / 每月 / 自訂時間框重置）           → 波段
//     模式 C  滾動 VWAP（最近 N 根成交量加權均價）                → 通用
//     模式 D  POC（最近 N 根成交量分佈的最大量價位，籌碼重心）    → 價格維度
//  判斷的不是重心的位置，而是：斜率 (上移/走平/下移)、穩定度 (N 根位移/ATR)、價格與重心的距離 (σ)。
//  訊號：重心上移 + 價在重心上 = 上升最低阻力；重心下移 + 價在重心下 = 下跌最低阻力；
//        重心走平且穩定 = 定錨 (主力未走)；價格跌破重心後 M 根內收回 = 假跌破 (用股價打掩護)。
// ═══════════════════════════════════════════════════════════════════════════
indicator("價格重心 Price Gravity r1", shorttitle = "價格重心", overlay = true, max_labels_count = 100, max_lines_count = 100)

// ── ① 重心定義 ──
grpG = "① 重心定義"
mode   = input.string("滾動 VWAP", "重心模式", options = ["當日 VWAP", "錨定 VWAP", "滾動 VWAP", "POC 成交量分佈"], group = grpG, display = display.none)
src    = input.source(hlc3, "價格來源", group = grpG, display = display.none)
anchTF = input.timeframe("W", "錨定時間框 (模式 B)", group = grpG, display = display.none)
lenN   = input.int(30, "滾動長度 N (模式 C / D)", minval = 5, maxval = 400, group = grpG, display = display.none)
bins   = input.int(40, "POC 分箱數 (模式 D)", minval = 10, maxval = 100, group = grpG, display = display.none)
kSig   = input.float(1.0, "成本帶寬 (± k σ，成交量加權)", minval = 0.25, maxval = 3, step = 0.25, group = grpG, display = display.none)

// ── ② 判斷參數 ──
grpJ = "② 斜率 / 穩定度 / 距離"
slopeM  = input.int(5, "斜率與穩定度窗口 M (根)", minval = 2, maxval = 50, group = grpJ, display = display.none)
stabThr = input.float(0.5, "穩定：M 根位移 ≤ 此 ATR 倍數", minval = 0.1, maxval = 3, step = 0.1, group = grpJ, display = display.none)
trendThr= input.float(0.8, "上移/下移：M 根位移 ≥ 此 ATR 倍數", minval = 0.2, maxval = 5, step = 0.1, group = grpJ, display = display.none)
fakeM   = input.int(3, "假跌破：跌破後幾根內收回", minval = 1, maxval = 10, group = grpJ, display = display.none)
atrLen  = input.int(14, "ATR 長度", minval = 5, group = grpJ, display = display.none)

// ── ⑦ 版面（與 R5/R6 相同規則：四支腳本設同一 boxW 即等寬貼右）──
grpL   = "⑦ 版面"
showBox = input.bool(true, "顯示資訊框", group = grpL, display = display.none)
boxW   = input.float(18, "資訊框寬度 (% 圖表寬)", minval = 8, maxval = 45, step = 0.5, group = grpL, display = display.none)
boxH   = input.float(40, "資訊框高度 (% pane 高)", minval = 20, maxval = 100, step = 5, group = grpL, display = display.none)
boxPos = input.string("右上", "位置", options = ["右上", "右中", "右下"], group = grpL, display = display.none)
f_boxPos(s) => s == "右上" ? position.top_right : s == "右下" ? position.bottom_right : position.middle_right
f_note(x, yAnchor, yBox, txt, col, above) =>
    lb = label.new(x, yBox, txt, style = above ? label.style_label_down : label.style_label_up,
         color = color.new(col, 40), textcolor = color.black, size = size.small)
    ln = line.new(x, yAnchor, x, yBox, color = color.new(col, 25), style = line.style_dotted, width = 1)
    [lb, ln]

// ── 重心計算 ──
atr = ta.atr(atrLen)
vol = nz(volume, 0.0)                       // 指數 (SPX 等) 沒有成交量 → 0，下面一律退回均價
smaSrc = ta.sma(src, lenN)
// A / B：ta.vwap 會在 anchor 為 true 的那根重置；沒有成交量時 ta.vwap 回傳 na → 退回均價
vwapDay = nz(ta.vwap(src, timeframe.change("D")), smaSrc)
vwapAnc = nz(ta.vwap(src, timeframe.change(anchTF)), smaSrc)
// C：滾動 VWAP
sumPV = math.sum(src * vol, lenN)
sumV  = math.sum(vol, lenN)
vwapRoll = sumV > 0 ? sumPV / sumV : smaSrc
// D：POC — 最近 lenN 根，把每根的成交量放進 hlc3 所在的箱（歷史不足 lenN 根時退回均價）
hiN = ta.highest(high, lenN)
loN = ta.lowest(low, lenN)
f_poc() =>
    step = (hiN - loN) / bins
    var vols = array.new_float(bins, 0.0)
    array.fill(vols, 0.0)
    ok = bar_index >= lenN and not na(step) and step > 0 and sumV > 0
    if ok
        for i = 0 to lenN - 1
            b = int(math.min(bins - 1, math.max(0, (nz(src[i], loN) - loN) / step)))
            array.set(vols, b, array.get(vols, b) + nz(volume[i], 0.0))
    idx = ok ? array.indexof(vols, array.max(vols)) : 0
    ok ? loN + (idx + 0.5) * step : smaSrc
pocVal = f_poc()

gravity = mode == "當日 VWAP" ? vwapDay : mode == "錨定 VWAP" ? vwapAnc : mode == "滾動 VWAP" ? vwapRoll : pocVal

// 成交量加權 σ（以滾動 N 根計，四種模式共用同一帶寬定義）
dev2  = math.sum(vol * math.pow(src - gravity, 2), lenN)
sigma = sumV > 0 ? math.sqrt(dev2 / sumV) : atr
sigma := na(sigma) or sigma <= 0 ? atr : sigma
upperB = gravity + kSig * sigma
lowerB = gravity - kSig * sigma

// ── 斜率 / 穩定度 / 距離 ──
shiftATR = atr > 0 ? (gravity - gravity[slopeM]) / atr : 0.0      // M 根位移 (ATR 倍數，正 = 上移)
stable   = math.abs(shiftATR) <= stabThr
gUp      = shiftATR >= trendThr
gDn      = shiftATR <= -trendThr
distSig  = sigma > 0 ? (close - gravity) / sigma : 0.0             // 價格距重心 (σ)
aboveG   = close > gravity

// 最低阻力方向
pathUp  = gUp and aboveG
pathDn  = gDn and not aboveG
anchor  = stable and math.abs(distSig) <= kSig                     // 定錨：重心穩、價在成本帶內

// 假跌破 / 假突破：收盤跌破重心後 fakeM 根內收回（主力用股價打掩護）
brokeDn = ta.crossunder(close, gravity)
brokeUp = ta.crossover(close, gravity)
barsBD  = ta.barssince(brokeDn)
barsBU  = ta.barssince(brokeUp)
fakeBD  = brokeUp and barsBD <= fakeM and barsBD > 0
fakeBU  = brokeDn and barsBU <= fakeM and barsBU > 0

// ── 繪圖 ──
gCol = gUp ? color.new(#26a69a, 0) : gDn ? color.new(#ef5350, 0) : color.new(#f59e0b, 0)
pG = plot(gravity, "價格重心", color = gCol, linewidth = 3, display = display.pane + display.data_window + display.price_scale)
pU = plot(upperB, "成本帶上緣", color = color.new(color.gray, 60), linewidth = 1, display = display.pane + display.data_window)
pL = plot(lowerB, "成本帶下緣", color = color.new(color.gray, 60), linewidth = 1, display = display.pane + display.data_window)
fill(pU, pL, color = anchor ? color.new(#f59e0b, 90) : color.new(color.gray, 94), title = "成本帶 (黃 = 定錨中)")
plot(shiftATR, "重心 M 根位移 (ATR)", display = display.data_window)
plot(distSig,  "價格距重心 (σ)",      display = display.data_window)

plotshape(pathUp and not pathUp[1], "上升最低阻力 開始", shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.tiny, text = "重心上移", textcolor = #26a69a)
plotshape(pathDn and not pathDn[1], "下跌最低阻力 開始", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.tiny, text = "重心下移", textcolor = #ef5350)
plotshape(anchor and not anchor[1], "定錨開始", shape.diamond, location.belowbar, color.new(#f59e0b, 0), size = size.tiny)

if fakeBD
    [l1, n1] = f_note(bar_index, low, low - atr * 0.8, "假跌破 收回重心", #26a69a, false)
if fakeBU
    [l2, n2] = f_note(bar_index, high, high + atr * 0.8, "假突破 跌回重心", #ef5350, true)

// ── 資訊框 ──
var table tb = table.new(f_boxPos(boxPos), 2, 7, bgcolor = color.new(#ffffff, 5),
     frame_color = color.black, frame_width = 2, border_width = 1, border_color = color.new(color.black, 85))
if showBox and barstate.islast
    rh = boxH / 7
    stateTxt = pathUp ? "上升最低阻力" : pathDn ? "下跌最低阻力" : anchor ? "定錨 (主力未走)" : stable ? "走平" : "位移中"
    stateCol = pathUp ? color.new(#26a69a, 60) : pathDn ? color.new(#ef5350, 60) : anchor ? color.new(#f59e0b, 60) : na
    table.cell(tb, 0, 0, "價格重心 · " + mode, width = boxW * 0.55, height = rh, text_size = size.small, text_color = color.white, bgcolor = color.new(#374151, 10))
    table.cell(tb, 1, 0, str.tostring(gravity, format.mintick), width = boxW * 0.45, height = rh, text_size = size.small, text_color = color.white, bgcolor = color.new(#374151, 10))
    table.cell(tb, 0, 1, "狀態", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 1, stateTxt, width = boxW * 0.45, height = rh, text_size = size.small, bgcolor = stateCol)
    table.cell(tb, 0, 2, "重心 " + str.tostring(slopeM) + " 根位移 (ATR)", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(shiftATR, "+#.##"), width = boxW * 0.45, height = rh, text_size = size.small, text_color = gUp ? #26a69a : gDn ? #ef5350 : color.gray)
    table.cell(tb, 0, 3, "價格距重心 (σ)", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(distSig, "+#.##"), width = boxW * 0.45, height = rh, text_size = size.small, text_color = aboveG ? #26a69a : #ef5350)
    table.cell(tb, 0, 4, "成本帶 (±" + str.tostring(kSig, "#.##") + "σ)", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(lowerB, format.mintick) + " – " + str.tostring(upperB, format.mintick), width = boxW * 0.45, height = rh, text_size = size.small)
    table.cell(tb, 0, 5, "當日 VWAP / 錨定 VWAP", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(vwapDay, format.mintick) + " / " + str.tostring(vwapAnc, format.mintick), width = boxW * 0.45, height = rh, text_size = size.small)
    table.cell(tb, 0, 6, "滾動 VWAP / POC", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 6, str.tostring(vwapRoll, format.mintick) + " / " + str.tostring(pocVal, format.mintick), width = boxW * 0.45, height = rh, text_size = size.small)

// ── 警報 ──
alertcondition(pathUp and not pathUp[1], "重心上移 · 上升最低阻力", "{{ticker}} 價格重心上移且價在重心上 — 上升最低阻力")
alertcondition(pathDn and not pathDn[1], "重心下移 · 下跌最低阻力", "{{ticker}} 價格重心下移且價在重心下 — 下跌最低阻力")
alertcondition(anchor and not anchor[1], "重心定錨", "{{ticker}} 價格重心走平且價在成本帶內 — 主力未走，可定錨")
// alertcondition 的訊息必須是常數字串（不能串接 input）——這是 r0 無法編譯、整支腳本不顯示的原因
alertcondition(fakeBD, "假跌破收回重心", "{{ticker}} 跌破價格重心後數根內收回 — 洗盤嫌疑")
alertcondition(fakeBU, "假突破跌回重心", "{{ticker}} 突破價格重心後數根內跌回 — 誘多嫌疑")

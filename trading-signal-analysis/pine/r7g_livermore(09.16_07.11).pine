//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  版本 r7(09:16_07:11)
//  R7-G  主圖：Livermore 最低阻力線 (Line of Least Resistance)
//
//  R7 七件套 —— 每支各佔一個 pane；策略 (A) 與價格重心 (E) 分開，可各自加減：
//     R7-A  主圖 (overlay)   EMA9 帶寬策略 + 進出場 + 狀態面板                r7a_main(09.16_07.11).pine
//     R7-B  下方 pane ①      MACD 柱狀圖 + 週期時鐘 + 背馳 + 升破前頂/跌破前底  r7b_macd_clock(09.16_07.11).pine
//     R7-C  下方 pane ②      VCP 指數 + 標準化成交量柱                         r7c_vcp(09.16_07.11).pine
//     R7-D  下方 pane ③      確定性指數 (高確定性著色)                         r7d_cert(09.16_07.11).pine
//     R7-E  主圖 (overlay)   價格重心 (VWAP / 錨定 / 滾動 / POC) + 成本帶 + 訊號  r7e_gravity(09.16_07.11).pine
//     R7-F  下方 pane ④      買賣力度 (1 分鐘近似主動買賣) + 結構低點 + 防守位   r7f_force(09.16_07.11).pine
//     R7-G  主圖 (overlay)   Livermore 最低阻力線：樞紐點結構 + Market Key 六欄 + 放量/跟進濾網  r7g_livermore(09.16_07.11).pine
//  六支的「⑦ 版面 boxW」設同一值即等寬貼右。R7-E 框預設右上 (高 40%)；同時載入 R7-A 時請把 R7-A 的框改 右下 / 高度 60。
//
//
//  Livermore 的最低阻力線不是任何平滑曲線，而是「市場自己在樞紐點上證明出來的方向」：
//    "Prices ... move along the line of least resistance ... wait for the moment when that line defines itself."
//  本腳本把他 1940 年《How to Trade in Stocks》的做法機械化，並用實測 (2025-09~2026-09 美股日線) 選出的設定：
//    ① 樞紐點 (Pivotal Points)：左 5 / 右 3 確認的轉折高低點；一頂高於一頂 + 一底高於一底 = 上升結構，反之下降結構。
//       收盤越過最後一個確認樞紐高 / 低 = 「線定義了自己」，直接翻轉結構（實測：沒有這條突破規則，純結構線的命中率只有 64 分）。
//    ② Market Key 六欄 (上升趨勢 / 自然反彈 / 次級反彈 / 下降趨勢 / 自然回檔 / 次級回檔)：
//       反轉門檻 3%（原著 $30 以上股票約 6 點）、確認門檻 1.5%（原著約 3 點）；實測 3%/1.5% 讀「趨勢欄」是 Livermore 原生方法中最佳。
//    ③ 兩道濾網：突破要放量 (≥1.5× 均量)；突破後 N 根內沒有跟進 = "a danger signal that must be heeded"。
//    ④ 參考雙線（實測結論）：EMA21 抓轉折最快 (反轉命中 82–93%)、SMA50 / Supertrend 判「趨勢仍在、回檔不出場」假訊號最少。
//  畫出的「最低阻力線」= 目前趨勢必守的樞紐價位：上升結構畫最後樞紐低（跌破即失效），下降結構畫最後樞紐高。
// ═══════════════════════════════════════════════════════════════════════════
indicator("R7-G Livermore Least-Resistance r7(09:16_07:11)", shorttitle = "R7-G Livermore", overlay = true, max_labels_count = 200, max_lines_count = 200)

// ── ① 樞紐點 ──
grpP = "① 樞紐點 (Pivotal Points)"
lbL    = input.int(5, "轉折左側確認根數", minval = 1, maxval = 20, group = grpP, display = display.none)
lbR    = input.int(3, "轉折右側確認根數 (Livermore 接受滯後 3–5 根)", minval = 1, maxval = 10, group = grpP, display = display.none)
brkPct = input.float(0.0, "突破樞紐點需超過 % (0 = 收盤越過即算)", minval = 0, maxval = 5, step = 0.25, group = grpP, display = display.none)

// ── ② Market Key ──
grpM = "② Market Key 六欄 (Livermore 1940)"
mkMode    = input.string("百分比", "門檻單位", options = ["百分比", "ATR 倍數"], group = grpM, display = display.none)
mkRev     = input.float(3.0, "反轉門檻 %：承認 自然反彈 / 回檔 (原著約 6 點)", minval = 0.5, maxval = 15, step = 0.5, group = grpM, display = display.none)
mkConf    = input.float(1.5, "確認門檻 %：越過樞紐價位 (原著約 3 點)", minval = 0.25, maxval = 10, step = 0.25, group = grpM, display = display.none)
mkRevAtr  = input.float(2.0, "反轉門檻 (ATR 倍數)", minval = 0.5, maxval = 6, step = 0.25, group = grpM, display = display.none)
mkConfAtr = input.float(1.0, "確認門檻 (ATR 倍數)", minval = 0.25, maxval = 4, step = 0.25, group = grpM, display = display.none)
atrLen    = input.int(20, "ATR 長度", minval = 5, group = grpM, display = display.none)

// ── ③ 成交量與跟進 ──
grpV = "③ 成交量確認與跟進 (Livermore 的兩道濾網)"
volLen     = input.int(50, "均量期數", minval = 5, group = grpV, display = display.none)
volX       = input.float(1.5, "突破放量門檻 (× 均量)", minval = 1, maxval = 5, step = 0.1, group = grpV, display = display.none)
followBars = input.int(3, "突破後幾根內必須跟進，否則危險訊號", minval = 1, maxval = 10, group = grpV, display = display.none)

// ── ④ 參考均線 ──
grpR = "④ 參考均線 (實測：EMA21 抓轉折、SMA50 判趨勢仍在)"
showFast = input.bool(true, "顯示 EMA21", group = grpR, display = display.none)
showSlow = input.bool(true, "顯示 SMA50", group = grpR, display = display.none)
showRng  = input.bool(true, "顯示最後樞紐高 / 低 (get-nowhere 區間邊緣)", group = grpR, display = display.none)
showAvw  = input.bool(true, "顯示事件錨定 AVWAP (自最近一次結構反轉起算的平均成本)", group = grpR, display = display.none)
rangeMult = input.float(3.0, "盤整箱：20 日高低差 < ATR × 此值 → 視為 get-nowhere (不表態)", minval = 1, maxval = 8, step = 0.5, group = grpR, display = display.none)
showBg   = input.bool(false, "狀態背景著色 (預設關閉)", group = grpR, display = display.none)

// ── ⑦ 版面 ──
grpL   = "⑦ 版面"
showBox = input.bool(true, "顯示資訊框", group = grpL, display = display.none)
boxW   = input.float(18, "資訊框寬度 (% 圖表寬)", minval = 8, maxval = 45, step = 0.5, group = grpL, display = display.none)
boxH   = input.float(40, "資訊框高度 (% pane 高)", minval = 20, maxval = 100, step = 5, group = grpL, display = display.none)
boxPos = input.string("右下", "位置", options = ["右上", "右中", "右下", "左上", "左中", "左下"], group = grpL, display = display.none)
f_boxPos(s) => s == "左上" ? position.top_left : s == "左中" ? position.middle_left : s == "左下" ? position.bottom_left :
     s == "右上" ? position.top_right : s == "右下" ? position.bottom_right : position.middle_right
f_note(x, yAnchor, yBox, txt, col, above) =>
    lb = label.new(x, yBox, txt, style = above ? label.style_label_down : label.style_label_up,
         color = color.new(col, 40), textcolor = color.black, size = size.small)
    ln = line.new(x, yAnchor, x, yBox, color = color.new(col, 25), style = line.style_dotted, width = 1)
    [lb, ln]

// ── 基礎序列 ──
atr   = ta.atr(atrLen)
vAvg  = ta.sma(volume, volLen)
ema21 = ta.ema(close, 21)
sma50 = ta.sma(close, 50)
volOK = volume >= vAvg * volX

// ── ① 樞紐點：最後兩個已確認的轉折高 / 低 ──
ph = ta.pivothigh(high, lbL, lbR)
pl = ta.pivotlow(low, lbL, lbR)
var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na
if not na(ph)
    ph2 := ph1
    ph1 := ph
if not na(pl)
    pl2 := pl1
    pl1 := pl
hh = ph1 > ph2
lh = ph1 < ph2
hl = pl1 > pl2
ll = pl1 < pl2

// 結構方向：HH+HL = 上升、LH+LL = 下降；收盤越過最後樞紐高 / 低 → 線定義了自己，立即翻轉
brkUp = ta.crossover(close, ph1 * (1 + brkPct / 100))
brkDn = ta.crossunder(close, pl1 * (1 - brkPct / 100))
var int structDir = 0
if hh and hl
    structDir := 1
else if lh and ll
    structDir := -1
if brkUp
    structDir := 1
if brkDn
    structDir := -1

// ── ② Market Key 六欄狀態機（只用收盤）──
//    mk：1 上升趨勢 UT、2 自然反彈、3 次級反彈、-1 下降趨勢 DT、-2 自然回檔、-3 次級回檔
var int   mk       = 0
var int   mkTrend  = 0          // 最後進入的趨勢欄 (UT = 1 / DT = -1) = Livermore 的黑線 / 紅線
var float colExt   = na         // 目前欄位的極值
var float lastUT   = na         // 各欄最後記錄的樞紐價位
var float lastDT   = na
var float lastNR   = na
var float lastNRe  = na
c = close
revAmt  = mkMode == "百分比" ? nz(colExt, c) * mkRev / 100 : atr * mkRevAtr
confAmt = mkMode == "百分比" ? c * mkConf / 100 : atr * mkConfAtr
if na(colExt)
    colExt := c
    mk := 1
    mkTrend := 1
else if mk == 1                                  // 上升趨勢欄
    if c > colExt
        colExt := c
    else if c <= colExt - revAmt
        lastUT := colExt
        mk := -2
        colExt := c
else if mk == -1                                 // 下降趨勢欄
    if c < colExt
        colExt := c
    else if c >= colExt + revAmt
        lastDT := colExt
        mk := 2
        colExt := c
else if mk == -2                                 // 自然回檔
    if c < colExt
        colExt := c
        if (not na(lastDT) and c < lastDT) or (not na(lastNRe) and c < lastNRe - confAmt)
            mk := -1
            mkTrend := -1
    else if c >= colExt + revAmt
        lastNRe := colExt
        colExt := c
        if not na(lastUT) and c > lastUT
            mk := 1
            mkTrend := 1
        else if not na(lastNR) and c < lastNR
            mk := 3
        else
            mk := 2
else if mk == 2                                  // 自然反彈
    if c > colExt
        colExt := c
        if (not na(lastUT) and c > lastUT) or (not na(lastNR) and c > lastNR + confAmt)
            mk := 1
            mkTrend := 1
    else if c <= colExt - revAmt
        lastNR := colExt
        colExt := c
        if not na(lastDT) and c < lastDT
            mk := -1
            mkTrend := -1
        else if not na(lastNRe) and c > lastNRe
            mk := -3
        else
            mk := -2
else if mk == 3                                  // 次級反彈
    if c > colExt
        colExt := c
        if not na(lastUT) and c > lastUT
            mk := 1
            mkTrend := 1
        else if not na(lastNR) and c > lastNR
            mk := 2
    else if c <= colExt - revAmt
        colExt := c
        mk := not na(lastNRe) and c < lastNRe ? -2 : -3
else if mk == -3                                 // 次級回檔
    if c < colExt
        colExt := c
        if not na(lastDT) and c < lastDT
            mk := -1
            mkTrend := -1
        else if not na(lastNRe) and c < lastNRe
            mk := -2
    else if c >= colExt + revAmt
        colExt := c
        mk := not na(lastNR) and c > lastNR ? 2 : 3
f_mkTxt(m) => m == 1 ? "上升趨勢 UT" : m == 2 ? "自然反彈" : m == 3 ? "次級反彈" : m == -1 ? "下降趨勢 DT" : m == -2 ? "自然回檔" : "次級回檔"

// ── 盤整箱 (get-nowhere prices)：20 日高低差太窄且尚未突破 → 不表態 ──
dcHi = ta.highest(high, 20)
dcLo = ta.lowest(low, 20)
inBox = (dcHi - dcLo) < atr * rangeMult and not brkUp and not brkDn

// ── 事件錨定 AVWAP：自最近一次結構反轉 (structDir 改變) 起算的成交量加權平均成本 ──
//    對應「越過關鍵點後，多方 / 空方誰被套」；取代滾動視窗的價格重心
var float aPV = 0.0
var float aV  = 0.0
if structDir != structDir[1]
    aPV := 0.0
    aV  := 0.0
aPV += hlc3 * nz(volume, 0)
aV  += nz(volume, 0)
avwap = aV > 0 ? aPV / aV : na

// ── 綜合：最低阻力方向 = 結構 (含突破) 與 Market Key 趨勢欄一致、且不在盤整箱內才算定義；否則「未定義 (get-nowhere)」──
lrDir  = inBox ? 0 : structDir == 1 and mkTrend == 1 ? 1 : structDir == -1 and mkTrend == -1 ? -1 : 0
lrLine = structDir == 1 ? pl1 : structDir == -1 ? ph1 : na        // 必守的樞紐價位
lrDist = not na(lrLine) ? (close - lrLine) / close * 100 : na
sma50Up = sma50 > sma50[5]

// ── ③ 突破放量與跟進（危險訊號）──
var int   brkBar   = na
var float brkClose = na
var float brkHigh  = na
var float brkLow   = na
var int   brkDir   = 0
if brkUp or brkDn
    brkBar   := bar_index
    brkClose := close
    brkHigh  := high
    brkLow   := low
    brkDir   := brkUp ? 1 : -1
// 跟進 = 突破後 followBars 根內至少創出突破根之上的新高 (向下反之)，且收盤沒有退回突破價
hiF = ta.highest(high, followBars)
loF = ta.lowest(low, followBars)
danger = not na(brkBar) and bar_index == brkBar + followBars and
     ((brkDir == 1 and (close <= brkClose or hiF <= brkHigh)) or (brkDir == -1 and (close >= brkClose or loF >= brkLow)))
volRatio = vAvg > 0 ? volume / vAvg : na

// ── 繪圖 ──
lrCol = lrDir == 1 ? color.new(#26a69a, 0) : lrDir == -1 ? color.new(#ef5350, 0) : color.new(#9ca3af, 0)
plot(lrLine, "最低阻力線 (趨勢必守樞紐)", color = lrCol, linewidth = 3, style = plot.style_stepline, display = display.pane + display.data_window + display.price_scale)
plot(showRng ? ph1 : na, "最後樞紐高", color = color.new(#ef5350, 65), linewidth = 1, style = plot.style_stepline, display = display.pane + display.data_window)
plot(showRng ? pl1 : na, "最後樞紐低", color = color.new(#26a69a, 65), linewidth = 1, style = plot.style_stepline, display = display.pane + display.data_window)
plot(showFast ? ema21 : na, "EMA21 (轉折參考)", color = color.new(#f59e0b, 30), linewidth = 1, display = display.pane + display.data_window)
plot(showSlow ? sma50 : na, "SMA50 (趨勢仍在參考)", color = color.new(#6b7280, 30), linewidth = 2, display = display.pane + display.data_window)
plot(showAvw ? avwap : na, "錨定 AVWAP (自最近反轉)", color = color.new(#8b5cf6, 20), linewidth = 2, style = plot.style_linebr, display = display.pane + display.data_window)
plot(structDir, "結構方向 (1/0/-1)", display = display.data_window)
plot(mk, "Market Key 欄 (1 UT 2 自然反彈 3 次級反彈 -1 DT -2 自然回檔 -3 次級回檔)", display = display.data_window)
bgcolor(showBg ? (lrDir == 1 ? color.new(#26a69a, 92) : lrDir == -1 ? color.new(#ef5350, 92) : na) : na, title = "最低阻力方向背景")

plotshape(brkUp, "升破樞紐高", shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.small)
plotshape(brkDn, "跌破樞紐低", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.small)
plotshape(mkTrend == 1 and mkTrend[1] != 1,   "Market Key 轉入上升趨勢欄", shape.circle, location.belowbar, color.new(#26a69a, 0), size = size.tiny)
plotshape(mkTrend == -1 and mkTrend[1] != -1, "Market Key 轉入下降趨勢欄", shape.circle, location.abovebar, color.new(#ef5350, 0), size = size.tiny)
if brkUp
    [l1, n1] = f_note(bar_index, low, low - atr * 0.9, volOK ? "線向上定義 · 放量 ✓" : "升破樞紐 · 未放量 ⚠", #26a69a, false)
if brkDn
    [l2, n2] = f_note(bar_index, high, high + atr * 0.9, volOK ? "線向下定義 · 放量 ✓" : "跌破樞紐 · 未放量 ⚠", #ef5350, true)
if danger
    [l3, n3] = f_note(bar_index, brkDir == 1 ? high : low, brkDir == 1 ? high + atr * 0.9 : low - atr * 0.9,
         "突破後無跟進 · 危險訊號", #f59e0b, brkDir == 1)

// ── 資訊框 ──
var table tb = table.new(f_boxPos(boxPos), 2, 8, bgcolor = color.new(#ffffff, 5),
     frame_color = color.black, frame_width = 2, border_width = 1, border_color = color.new(color.black, 85))
if showBox and barstate.islast
    rh = boxH / 8
    stTxt = lrDir == 1 ? "上升最低阻力 ✓" : lrDir == -1 ? "下降最低阻力 ✓" : inBox ? "盤整箱 · 不表態" : "未定義 (結構與 Market Key 不一致)"
    stCol = lrDir == 1 ? color.new(#26a69a, 60) : lrDir == -1 ? color.new(#ef5350, 60) : color.new(#9ca3af, 70)
    table.cell(tb, 0, 0, "Livermore 最低阻力線", width = boxW * 0.55, height = rh, text_size = size.small, text_color = color.white, bgcolor = color.new(#374151, 10))
    table.cell(tb, 1, 0, stTxt, width = boxW * 0.45, height = rh, text_size = size.small, text_color = color.white, bgcolor = color.new(#374151, 10))
    table.cell(tb, 0, 1, "結構 (樞紐 " + str.tostring(lbL) + "/" + str.tostring(lbR) + ")", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 1, structDir == 1 ? "HH+HL 上升" : structDir == -1 ? "LH+LL 下降" : "混合", width = boxW * 0.45, height = rh, text_size = size.small, bgcolor = stCol)
    table.cell(tb, 0, 2, "Market Key 欄 / 趨勢欄", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 2, f_mkTxt(mk) + " / " + (mkTrend == 1 ? "UT" : "DT"), width = boxW * 0.45, height = rh, text_size = size.small,
         text_color = mkTrend == 1 ? #26a69a : #ef5350)
    table.cell(tb, 0, 3, "最後樞紐 高 / 低", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(ph1, format.mintick) + " / " + str.tostring(pl1, format.mintick), width = boxW * 0.45, height = rh, text_size = size.small)
    table.cell(tb, 0, 4, "必守樞紐 · 距離", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 4, na(lrLine) ? "—" : str.tostring(lrLine, format.mintick) + " (" + str.tostring(lrDist, "+#.#") + "%)", width = boxW * 0.45, height = rh, text_size = size.small,
         text_color = lrDir == 1 ? #26a69a : lrDir == -1 ? #ef5350 : color.gray)
    table.cell(tb, 0, 5, "本根量比 (突破需 ≥" + str.tostring(volX, "#.#") + "×)", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(volRatio, "#.##") + "×" + (volOK ? " 放量" : ""), width = boxW * 0.45, height = rh, text_size = size.small, bgcolor = volOK ? color.new(#f59e0b, 60) : na)
    table.cell(tb, 0, 6, "EMA21 / SMA50(升降) / 錨定AVWAP", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 6, (close > ema21 ? "上" : "下") + " / " + (close > sma50 ? "上" : "下") + (sma50Up ? "↑" : "↓") + " / " + (na(avwap) ? "—" : close > avwap ? "上" : "下"),
         width = boxW * 0.45, height = rh, text_size = size.small, text_color = close > sma50 ? #26a69a : #ef5350)
    table.cell(tb, 0, 7, "說明", width = boxW * 0.55, height = rh, text_size = size.tiny, text_color = color.gray)
    table.cell(tb, 1, 7, "▲▼ 樞紐突破 ● Market Key 趨勢欄", width = boxW * 0.45, height = rh, text_size = size.tiny, text_color = color.gray)

// ── 警報 ──
alertcondition(brkUp, "Livermore 線向上定義 (升破樞紐高)", "{{ticker}} 收盤升破最後樞紐高 — 最低阻力線向上定義，檢查是否放量")
alertcondition(brkDn, "Livermore 線向下定義 (跌破樞紐低)", "{{ticker}} 收盤跌破最後樞紐低 — 最低阻力線向下定義，檢查是否放量")
alertcondition(danger, "Livermore 危險訊號 (突破後無跟進)", "{{ticker}} 突破樞紐點後數根內沒有跟進 — Livermore 危險訊號")
alertcondition(mkTrend == 1 and mkTrend[1] != 1,   "Market Key 轉入上升趨勢欄", "{{ticker}} Market Key 進入上升趨勢欄")
alertcondition(mkTrend == -1 and mkTrend[1] != -1, "Market Key 轉入下降趨勢欄", "{{ticker}} Market Key 進入下降趨勢欄")

//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  版本 r7(09:16_13:27)
//  R7-G  主圖：Livermore 最低阻力線 (Line of Least Resistance)
//
//  R7 七件套 —— 每支各佔一個 pane；策略 (A) 與價格重心 (E) 分開，可各自加減：
//     R7-A  主圖 (overlay)   EMA9 帶寬策略 + 進出場 + 狀態面板                r7a_main(09.16_13.27).pine
//     R7-B  下方 pane ①      MACD 柱狀圖 + 週期時鐘 + 背馳 + 升破前頂/跌破前底  r7b_macd_clock(09.16_13.27).pine
//     R7-C  下方 pane ②      VCP 指數 + 標準化成交量柱                         r7c_vcp(09.16_13.27).pine
//     R7-D  下方 pane ③      確定性指數 (高確定性著色)                         r7d_cert(09.16_13.27).pine
//     R7-E  主圖 (overlay)   價格重心 (VWAP / 錨定 / 滾動 / POC) + 成本帶 + 訊號  r7e_gravity(09.16_13.27).pine
//     R7-F  下方 pane ④      買賣力度 (1 分鐘近似主動買賣) + 結構低點 + 防守位   r7f_force(09.16_13.27).pine
//     R7-G  主圖 (overlay)   Livermore 最低阻力線：樞紐點結構 + Market Key 六欄 + 放量/跟進濾網  r7g_livermore(09.16_13.27).pine
//  六支的「⑦ 版面 boxW」設同一值即等寬貼右。R7-E 框預設右上 (高 40%)；同時載入 R7-A 時請把 R7-A 的框改 右下 / 高度 60。
//
//
//  Livermore 的最低阻力線不是平滑曲線，而是「市場在樞紐點上自己證明的方向」：
//    "Prices ... move along the line of least resistance ... wait for the moment when that line defines itself."
//  這條線 = 目前趨勢「必守的樞紐價位」（他 Market Key 帳上的紅線 / 黑線）：
//    上升趨勢 → 最近一個回檔低點（跌破即趨勢失效）；下降趨勢 → 最近一個反彈高點。
//  r1 中短線化（不改邏輯，只縮短「線與 K 線的距離」）：
//    ① 樞紐點改用 左 3 / 右 2 確認（原 5/3），抓的是中短線的擺動而不是大波段；
//    ② 線取「最近確認樞紐低」與「Market Key 最近自然回檔低」兩者中較貼近價格者，並且只會向趨勢方向棘輪
//       （上升趨勢中只升不降，這正是 Livermore 隨趨勢上移停損的做法）；
//    ③ Market Key 反轉 / 確認門檻 3%/1.5% → 2%/1%（原著 6/3 點是給 $30 以上大波段用的）；
//    ④ 盤整箱視窗 20 → 10 根。
//  仍保留：收盤越過樞紐 = 線定義自己（立即翻轉）、突破放量、突破後跟進（否則危險訊號）。
//  不再畫 EMA21 / SMA50 / AVWAP / 樞紐高低參考線；圖上只有這一條線 + 突破記號。
// ═══════════════════════════════════════════════════════════════════════════
indicator("R7-G Livermore Least-Resistance r7(09:16_13:27)", shorttitle = "R7-G Livermore", overlay = true, max_labels_count = 200, max_lines_count = 200)

// ── ① 樞紐點 ──
grpP = "① 樞紐點 (Pivotal Points) — 中短線"
lbL    = input.int(3, "轉折左側確認根數", minval = 1, maxval = 20, group = grpP, display = display.none)
lbR    = input.int(2, "轉折右側確認根數", minval = 1, maxval = 10, group = grpP, display = display.none)
brkPct = input.float(0.0, "突破樞紐點需超過 % (0 = 收盤越過即算)", minval = 0, maxval = 5, step = 0.25, group = grpP, display = display.none)
boxLen = input.int(10, "盤整箱視窗 (根)", minval = 5, maxval = 60, group = grpP, display = display.none)
rangeMult = input.float(2.5, "盤整箱：視窗高低差 < ATR × 此值 → 不表態", minval = 1, maxval = 8, step = 0.5, group = grpP, display = display.none)

// ── ② Market Key ──
grpM = "② Market Key 六欄 (Livermore 1940) — 中短線門檻"
mkMode    = input.string("百分比", "門檻單位", options = ["百分比", "ATR 倍數"], group = grpM, display = display.none)
mkRev     = input.float(2.0, "反轉門檻 %：承認 自然反彈 / 回檔", minval = 0.5, maxval = 15, step = 0.5, group = grpM, display = display.none)
mkConf    = input.float(1.0, "確認門檻 %：越過樞紐價位", minval = 0.25, maxval = 10, step = 0.25, group = grpM, display = display.none)
mkRevAtr  = input.float(1.5, "反轉門檻 (ATR 倍數)", minval = 0.5, maxval = 6, step = 0.25, group = grpM, display = display.none)
mkConfAtr = input.float(0.75, "確認門檻 (ATR 倍數)", minval = 0.25, maxval = 4, step = 0.25, group = grpM, display = display.none)
atrLen    = input.int(14, "ATR 長度", minval = 5, group = grpM, display = display.none)

// ── ③ 成交量與跟進 ──
grpV = "③ 成交量確認與跟進"
volLen     = input.int(50, "均量期數", minval = 5, group = grpV, display = display.none)
volX       = input.float(1.5, "突破放量門檻 (× 均量)", minval = 1, maxval = 5, step = 0.1, group = grpV, display = display.none)
followBars = input.int(3, "突破後幾根內必須跟進，否則危險訊號", minval = 1, maxval = 10, group = grpV, display = display.none)
showMarks  = input.bool(true, "顯示突破 ▲▼ 與備註框", group = grpV, display = display.none)

// ── ⑦ 版面 ──
grpL   = "⑦ 版面"
showBox = input.bool(true, "顯示資訊框", group = grpL, display = display.none)
boxW   = input.float(18, "資訊框寬度 (% 圖表寬)", minval = 8, maxval = 45, step = 0.5, group = grpL, display = display.none)
boxH   = input.float(35, "資訊框高度 (% pane 高)", minval = 20, maxval = 100, step = 5, group = grpL, display = display.none)
boxPos = input.string("右下", "位置", options = ["右上", "右中", "右下", "左上", "左中", "左下"], group = grpL, display = display.none)
f_boxPos(s) => s == "左上" ? position.top_left : s == "左中" ? position.middle_left : s == "左下" ? position.bottom_left :
     s == "右上" ? position.top_right : s == "右下" ? position.bottom_right : position.middle_right
f_note(x, yAnchor, yBox, txt, col, above) =>
    lb = label.new(x, yBox, txt, style = above ? label.style_label_down : label.style_label_up,
         color = color.new(col, 40), textcolor = color.black, size = size.small)
    ln = line.new(x, yAnchor, x, yBox, color = color.new(col, 25), style = line.style_dotted, width = 1)
    [lb, ln]

// ── 基礎序列 ──
atr   = ta.atr(atrLen)
vAvg  = ta.sma(volume, volLen)
volOK = volume >= vAvg * volX
volRatio = vAvg > 0 ? volume / vAvg : na

// ── ① 樞紐點：最後兩個已確認的轉折高 / 低 ──
ph = ta.pivothigh(high, lbL, lbR)
pl = ta.pivotlow(low, lbL, lbR)
var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na
if not na(ph)
    ph2 := ph1
    ph1 := ph
if not na(pl)
    pl2 := pl1
    pl1 := pl
hh = ph1 > ph2
lh = ph1 < ph2
hl = pl1 > pl2
ll = pl1 < pl2

// 結構方向：HH+HL = 上升、LH+LL = 下降；收盤越過最後樞紐高 / 低 → 線定義了自己，立即翻轉
brkUp = ta.crossover(close, ph1 * (1 + brkPct / 100))
brkDn = ta.crossunder(close, pl1 * (1 - brkPct / 100))
var int structDir = 0
if hh and hl
    structDir := 1
else if lh and ll
    structDir := -1
if brkUp
    structDir := 1
if brkDn
    structDir := -1

// ── ② Market Key 六欄狀態機（只用收盤）──
//    mk：1 上升趨勢 UT、2 自然反彈、3 次級反彈、-1 下降趨勢 DT、-2 自然回檔、-3 次級回檔
var int   mk       = 0
var int   mkTrend  = 0
var float colExt   = na
var float lastUT   = na
var float lastDT   = na
var float lastNR   = na          // 最近自然反彈高
var float lastNRe  = na          // 最近自然回檔低
c = close
revAmt  = mkMode == "百分比" ? nz(colExt, c) * mkRev / 100 : atr * mkRevAtr
confAmt = mkMode == "百分比" ? c * mkConf / 100 : atr * mkConfAtr
if na(colExt)
    colExt := c
    mk := 1
    mkTrend := 1
else if mk == 1
    if c > colExt
        colExt := c
    else if c <= colExt - revAmt
        lastUT := colExt
        mk := -2
        colExt := c
else if mk == -1
    if c < colExt
        colExt := c
    else if c >= colExt + revAmt
        lastDT := colExt
        mk := 2
        colExt := c
else if mk == -2
    if c < colExt
        colExt := c
        if (not na(lastDT) and c < lastDT) or (not na(lastNRe) and c < lastNRe - confAmt)
            mk := -1
            mkTrend := -1
    else if c >= colExt + revAmt
        lastNRe := colExt
        colExt := c
        if not na(lastUT) and c > lastUT
            mk := 1
            mkTrend := 1
        else if not na(lastNR) and c < lastNR
            mk := 3
        else
            mk := 2
else if mk == 2
    if c > colExt
        colExt := c
        if (not na(lastUT) and c > lastUT) or (not na(lastNR) and c > lastNR + confAmt)
            mk := 1
            mkTrend := 1
    else if c <= colExt - revAmt
        lastNR := colExt
        colExt := c
        if not na(lastDT) and c < lastDT
            mk := -1
            mkTrend := -1
        else if not na(lastNRe) and c > lastNRe
            mk := -3
        else
            mk := -2
else if mk == 3
    if c > colExt
        colExt := c
        if not na(lastUT) and c > lastUT
            mk := 1
            mkTrend := 1
        else if not na(lastNR) and c > lastNR
            mk := 2
    else if c <= colExt - revAmt
        colExt := c
        mk := not na(lastNRe) and c < lastNRe ? -2 : -3
else if mk == -3
    if c < colExt
        colExt := c
        if not na(lastDT) and c < lastDT
            mk := -1
            mkTrend := -1
        else if not na(lastNRe) and c < lastNRe
            mk := -2
    else if c >= colExt + revAmt
        colExt := c
        mk := not na(lastNR) and c > lastNR ? 2 : 3
f_mkTxt(m) => m == 1 ? "上升趨勢 UT" : m == 2 ? "自然反彈" : m == 3 ? "次級反彈" : m == -1 ? "下降趨勢 DT" : m == -2 ? "自然回檔" : "次級回檔"

// ── 盤整箱 (get-nowhere prices) ──
inBox = (ta.highest(high, boxLen) - ta.lowest(low, boxLen)) < atr * rangeMult and not brkUp and not brkDn

// ── 這一條線：趨勢必守的樞紐價位，取較貼近價格者，並沿趨勢方向棘輪 ──
//    上升：max(最近確認樞紐低, Market Key 最近自然回檔低)，兩者都必須在價格之下；只升不降
//    下降：min(最近確認樞紐高, Market Key 最近自然反彈高)，兩者都必須在價格之上；只降不升
//    趨勢翻轉時重新定位到新趨勢的第一個樞紐
var float lrLine = na
upC1 = not na(pl1) and pl1 < close ? pl1 : na
upC2 = not na(lastNRe) and lastNRe < close ? lastNRe : na
upCand = na(upC1) ? upC2 : na(upC2) ? upC1 : math.max(upC1, upC2)
dnC1 = not na(ph1) and ph1 > close ? ph1 : na
dnC2 = not na(lastNR) and lastNR > close ? lastNR : na
dnCand = na(dnC1) ? dnC2 : na(dnC2) ? dnC1 : math.min(dnC1, dnC2)
if structDir == 1
    lrLine := structDir[1] != 1 or na(lrLine) ? upCand : na(upCand) ? lrLine : math.max(lrLine, upCand)
else if structDir == -1
    lrLine := structDir[1] != -1 or na(lrLine) ? dnCand : na(dnCand) ? lrLine : math.min(lrLine, dnCand)
lrDir  = inBox ? 0 : structDir == 1 and mkTrend == 1 ? 1 : structDir == -1 and mkTrend == -1 ? -1 : 0
lrDist = not na(lrLine) ? (close - lrLine) / close * 100 : na

// ── ③ 突破放量與跟進（危險訊號）──
var int   brkBar   = na
var float brkClose = na
var float brkHigh  = na
var float brkLow   = na
var int   brkDir   = 0
if brkUp or brkDn
    brkBar   := bar_index
    brkClose := close
    brkHigh  := high
    brkLow   := low
    brkDir   := brkUp ? 1 : -1
hiF = ta.highest(high, followBars)
loF = ta.lowest(low, followBars)
danger = not na(brkBar) and bar_index == brkBar + followBars and
     ((brkDir == 1 and (close <= brkClose or hiF <= brkHigh)) or (brkDir == -1 and (close >= brkClose or loF >= brkLow)))

// ── 繪圖：只有一條線 ──
lrCol = lrDir == 1 ? color.new(#26a69a, 0) : lrDir == -1 ? color.new(#ef5350, 0) : color.new(#9ca3af, 0)
plot(lrLine, "Livermore 最低阻力線", color = lrCol, linewidth = 3, style = plot.style_stepline, display = display.pane + display.data_window + display.price_scale)
plot(structDir, "結構方向 (1/0/-1)", display = display.data_window)
plot(mk, "Market Key 欄", display = display.data_window)
plot(ph1, "最後樞紐高 (數值)", display = display.data_window)
plot(pl1, "最後樞紐低 (數值)", display = display.data_window)

plotshape(showMarks and brkUp, "升破樞紐高", shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.tiny)
plotshape(showMarks and brkDn, "跌破樞紐低", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.tiny)
if showMarks and brkUp
    [l1, n1] = f_note(bar_index, low, low - atr * 0.9, volOK ? "線向上定義 · 放量 ✓" : "升破樞紐 · 未放量 ⚠", #26a69a, false)
if showMarks and brkDn
    [l2, n2] = f_note(bar_index, high, high + atr * 0.9, volOK ? "線向下定義 · 放量 ✓" : "跌破樞紐 · 未放量 ⚠", #ef5350, true)
if showMarks and danger
    [l3, n3] = f_note(bar_index, brkDir == 1 ? high : low, brkDir == 1 ? high + atr * 0.9 : low - atr * 0.9,
         "突破後無跟進 · 危險訊號", #f59e0b, brkDir == 1)

// ── 資訊框 ──
var table tb = table.new(f_boxPos(boxPos), 2, 7, bgcolor = color.new(#ffffff, 5),
     frame_color = color.black, frame_width = 2, border_width = 1, border_color = color.new(color.black, 85))
if showBox and barstate.islast
    rh = boxH / 7
    stTxt = lrDir == 1 ? "上升最低阻力 ✓" : lrDir == -1 ? "下降最低阻力 ✓" : inBox ? "盤整箱 · 不表態" : "未定義"
    stCol = lrDir == 1 ? color.new(#26a69a, 60) : lrDir == -1 ? color.new(#ef5350, 60) : color.new(#9ca3af, 70)
    table.cell(tb, 0, 0, "Livermore 最低阻力線 (中短線)", width = boxW * 0.55, height = rh, text_size = size.small, text_color = color.white, bgcolor = color.new(#374151, 10))
    table.cell(tb, 1, 0, stTxt, width = boxW * 0.45, height = rh, text_size = size.small, text_color = color.white, bgcolor = color.new(#374151, 10))
    table.cell(tb, 0, 1, "線位 · 價格距線", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 1, na(lrLine) ? "—" : str.tostring(lrLine, format.mintick) + " (" + str.tostring(lrDist, "+#.#") + "%)", width = boxW * 0.45, height = rh, text_size = size.small,
         text_color = lrDir == 1 ? #26a69a : lrDir == -1 ? #ef5350 : color.gray, bgcolor = stCol)
    table.cell(tb, 0, 2, "結構 (樞紐 " + str.tostring(lbL) + "/" + str.tostring(lbR) + ")", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 2, structDir == 1 ? "HH+HL 上升" : structDir == -1 ? "LH+LL 下降" : "混合", width = boxW * 0.45, height = rh, text_size = size.small)
    table.cell(tb, 0, 3, "Market Key 欄 / 趨勢欄", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 3, f_mkTxt(mk) + " / " + (mkTrend == 1 ? "UT" : "DT"), width = boxW * 0.45, height = rh, text_size = size.small,
         text_color = mkTrend == 1 ? #26a69a : #ef5350)
    table.cell(tb, 0, 4, "最後樞紐 高 / 低", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(ph1, format.mintick) + " / " + str.tostring(pl1, format.mintick), width = boxW * 0.45, height = rh, text_size = size.small)
    table.cell(tb, 0, 5, "本根量比 (突破需 ≥" + str.tostring(volX, "#.#") + "×)", width = boxW * 0.55, height = rh, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(volRatio, "#.##") + "×" + (volOK ? " 放量" : ""), width = boxW * 0.45, height = rh, text_size = size.small, bgcolor = volOK ? color.new(#f59e0b, 60) : na)
    table.cell(tb, 0, 6, "說明", width = boxW * 0.55, height = rh, text_size = size.tiny, text_color = color.gray)
    table.cell(tb, 1, 6, "線 = 趨勢必守樞紐，只沿趨勢棘輪", width = boxW * 0.45, height = rh, text_size = size.tiny, text_color = color.gray)

// ── 警報 ──
alertcondition(brkUp, "Livermore 線向上定義 (升破樞紐高)", "{{ticker}} 收盤升破最後樞紐高 — 最低阻力線向上定義，檢查是否放量")
alertcondition(brkDn, "Livermore 線向下定義 (跌破樞紐低)", "{{ticker}} 收盤跌破最後樞紐低 — 最低阻力線向下定義，檢查是否放量")
alertcondition(danger, "Livermore 危險訊號 (突破後無跟進)", "{{ticker}} 突破樞紐點後數根內沒有跟進 — Livermore 危險訊號")
alertcondition(mkTrend == 1 and mkTrend[1] != 1,   "Market Key 轉入上升趨勢欄", "{{ticker}} Market Key 進入上升趨勢欄")
alertcondition(mkTrend == -1 and mkTrend[1] != -1, "Market Key 轉入下降趨勢欄", "{{ticker}} Market Key 進入下降趨勢欄")

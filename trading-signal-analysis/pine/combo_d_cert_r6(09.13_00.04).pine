//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  版本 r6(09:13_00:04)
//  R6-D  下方 pane：確定性指數曲線
//
//  R6 套件 —— Pine 一個腳本只能佔一個 pane，故 R4 的單檔拆成四支，各佔一個 pane：
//     R6-A  主圖 (overlay)   EMA9 帶寬策略 + 進出場 + 狀態面板        combo_a_main_r6(09.13_00.04).pine
//     R6-B  下方 pane ①      MACD 柱狀圖 + 週期時鐘 (時鐘在最右邊)     combo_b_macd_clock_r6(09.13_00.04).pine
//     R6-C  下方 pane ②      VCP 指數曲線 0–100 + 等級                combo_c_vcp_r6(09.13_00.04).pine
//     R6-D  下方 pane ③      確定性指數曲線 0–100 + 7 分項            combo_d_cert_r6(09.13_00.04).pine
//  四支的計算邏輯與 R4 逐字相同，只改「畫在哪個 pane」與各自的呈現方式。
//
//  本檔內容：MODULE 3-A。把 7 項加權後的 0–100 確定性總分畫成一條曲線，
//  7 個分項各自可選顯示為細線，有「一底高於一底」結構時背景轉綠，
//  右側面板列出 7 項各自的進度條與分數。
//  算法與 R4 的 MODULE 3 逐字相同（來源：VCP-watchlist repo build_r17_data.py）。
// ═══════════════════════════════════════════════════════════════════════════

indicator("R6-D Certainty 7 r6(09:13_00:04)", shorttitle = "R6-D Cert7", overlay = false)

grpV = "M3 ① 資料來源"
m3TF  = input.timeframe("D", "計算時間框 (預設日線)", group = grpV)
bench = input.symbol("SPY", "相對強度 (RS) 基準", group = grpV)

grpW = "② 面板"
showCert  = input.bool(true, "顯示 7 分項面板 (本 pane 右側)", group = grpW)
certAlert = input.float(70, "確定性警報門檻 (≥)", minval = 0, maxval = 100, group = grpW)
showParts = input.bool(false, "同時畫出 7 個分項細線", group = grpW)
showHLbg  = input.bool(false, "一底高於一底 結構背景 (淡綠；R6 預設關閉)", group = grpW)

// ── ⑦ 版面（四支 R6 腳本請設同一 boxW，四個資訊框即等寬、右緣對齊）──
grpL   = "⑦ 版面 (四個 pane 統一)"
boxW   = input.float(18, "資訊框寬度 (% 圖表寬；四支腳本設同值)", minval = 8, maxval = 45, step = 0.5, group = grpL)
boxH   = input.float(100, "資訊框高度 (% 本 pane 高；100 = 撐滿)", minval = 30, maxval = 100, step = 5, group = grpL)
boxPos = input.string("右中", "垂直位置 (高度 <100 時才有差別)", options = ["右上", "右中", "右下"], group = grpL)
f_boxPos(s) => s == "右上" ? position.top_right : s == "右下" ? position.bottom_right : position.middle_right

f_clamp01(x) => math.max(0.0, math.min(1.0, x))

f_pos(s) => s == "左上" ? position.top_left : s == "左中" ? position.middle_left : s == "左下" ? position.bottom_left :
     s == "右上" ? position.top_right : s == "右中" ? position.middle_right : position.bottom_right

f_bar(v, n) =>          // 0–1 → n 格文字進度條
    string b = ""
    k = math.round(v * n)
    for i = 1 to n
        b += i <= k ? "█" : "░"
    b

// ── 3-A 確定性 7 項 (在日線環境執行) ──
f_cert7() =>
    // 均線排列：價>MA20 (0.4) / MA20>MA50 (0.3) / MA50 較 10 日前上升 (0.3)
    ma20 = ta.sma(close, 20)
    ma50 = ta.sma(close, 50)
    f1 = close > ma20
    f2 = ma20 > ma50
    f3 = ma50 > ma50[10]
    sMa = 0.4 * (f1 ? 1.0 : 0.0) + 0.3 * (f2 ? 1.0 : 0.0) + 0.3 * (f3 ? 1.0 : 0.0)

    // 量縮：近 15 日「跌日均量 ÷ 漲日均量」，越低越好
    float upV = 0.0
    float dnV = 0.0
    int   upN = 0
    int   dnN = 0
    for k = 0 to 14
        if close[k] > close[k + 1]
            upV += volume[k]
            upN += 1
        else if close[k] < close[k + 1]
            dnV += volume[k]
            dnN += 1
    dv  = (upN > 0 and dnN > 0 and upV > 0) ? (dnV / dnN) / (upV / upN) : 1.0
    sDv = f_clamp01((1.4 - dv) / 0.8)

    // 底部偵測：±3 根局部最低收盤，3 根內重複取較低者；由舊到新存入陣列 (offset 44 → 3)
    bOff = array.new_int()
    bPx  = array.new_float()
    for k = 44 to 3
        c0 = close[k]
        if not na(c0) and not na(close[k + 3])
            isMin = true
            for j = -3 to 3
                if close[k + j] < c0
                    isMin := false
            if isMin and close[k + 3] > c0 and close[k - 3] > c0
                nb0 = array.size(bOff)
                bool dup = false
                if nb0 > 0
                    dup := array.get(bOff, nb0 - 1) - k <= 3     // 3 根內重複
                if dup
                    if c0 < array.get(bPx, nb0 - 1)
                        array.set(bOff, nb0 - 1, k)
                        array.set(bPx,  nb0 - 1, c0)
                else
                    array.push(bOff, k)
                    array.push(bPx,  c0)

    // 一底高於一底：窗內 ≥2 個底、價格嚴格遞增、最近一底在 25 根內
    nb = array.size(bOff)
    bool hlOk = false
    if nb >= 2                                   // 先確認陣列非空再取值 (Pine 的 and 不短路)
        hlOk := array.get(bOff, nb - 1) <= 24
        if hlOk
            for k = 1 to nb - 1
                if array.get(bPx, k) <= array.get(bPx, k - 1)
                    hlOk := false

    float sBreak = 0.0
    float sRetr  = 0.0
    float sTime  = 0.0
    float sContr = 0.0
    float contr  = na
    int   dHeld  = 0
    bool  broke  = false
    if hlOk
        oP = array.get(bOff, nb - 2)
        oL = array.get(bOff, nb - 1)
        pL = array.get(bPx,  nb - 1)
        // H_mid：兩底之間的最高收盤
        hMid = close[oP]
        for k = oL + 1 to oP
            hMid := math.max(hMid, close[k])
        // 最近一底之後的最高 / 最低收盤
        postHigh = close
        postMin  = close
        for k = 0 to oL - 1
            postHigh := math.max(postHigh, close[k])
            postMin  := math.min(postMin,  close[k])
        broke   := postHigh > hMid
        progress = hMid > pL ? (close - pL) / (hMid - pL) : 1.0
        sBreak  := broke ? 1.0 : 0.6 * f_clamp01(progress)      // 突破 (已破前高=1)
        sRetr   := f_clamp01(progress)                           // 回升 (跌幅收復比例)
        dHeld   := oL
        undercut = postMin < pL * 0.999
        sTime   := math.min(1.0, dHeld / 15.0) * (undercut ? 0.25 : 1.0)   // 守底天數 (跌破低點 ×0.25)
        // 收縮：各底回檔深度，最後一段 ÷ 第一段 (越小越好)
        depths = array.new_float()
        for k = 0 to nb - 1
            bo = array.get(bOff, k)
            bp = array.get(bPx,  k)
            hi = bp
            if k == 0
                for j = bo + 1 to bo + 10
                    if not na(close[j])
                        hi := math.max(hi, close[j])
            else
                po = array.get(bOff, k - 1)
                for j = bo + 1 to po
                    hi := math.max(hi, close[j])
            if hi > bp
                array.push(depths, (hi - bp) / hi)
        nd = array.size(depths)
        // 用 if 而非 ternary：Pine 的 ?: 兩邊都會求值，空陣列會在此越界並中斷整根 K 線的執行
        contr := 1.0
        if nd >= 2
            d0 = array.get(depths, 0)
            if d0 > 1e-4
                contr := array.get(depths, nd - 1) / d0
        sContr := f_clamp01(1.0 - contr)

    ret21 = bar_index >= 21 ? close / close[21] - 1 : 0.0
    [sBreak, sRetr, sTime, sDv, sContr, sMa, hlOk, dv, contr, dHeld, broke, ret21, nb]

// ── 3-B VCP 分數 / 等級 (vcp_classify，在日線環境執行) ──
f_vcp() =>
    p = close
    hi52 = ta.highest(close, 252)
    lo52 = ta.lowest(close, 252)
    hiN  = ta.highest(close, math.min(252, bar_index + 1))
    loN  = ta.lowest(close,  math.min(252, bar_index + 1))
    hiY  = na(hi52) ? hiN : hi52
    loY  = na(lo52) ? loN : lo52
    offHigh  = (hiY - p) / hiY * 100
    aboveLow = loY > 0 ? (p - loY) / loY * 100 : 0.0
    ma50  = ta.sma(close, 50)
    ma200 = ta.sma(close, 200)
    has50  = not na(ma50)
    has200 = not na(ma200)
    a50raw = has50 and p > ma50
    // 無 MA200 時以「站上 MA50 且距高 ≤25%」代理長期趨勢 (同原算法)
    a200  = has200 ? p > ma200 : (has50 ? (a50raw and offHigh <= 25) : (aboveLow >= 25 and offHigh <= 20))
    cross = has200 ? (has50 ? ma50 > ma200 : a200) : a200
    a50   = has50 ? a50raw : a200
    trendOK = a50 and a200 and cross and aboveLow >= 30 and offHigh <= 25
    c1  = bar_index >= 21  ? (close / close[21]  - 1) * 100 : 0.0
    c3  = bar_index >= 63  ? (close / close[63]  - 1) * 100 : c1
    c6  = bar_index >= 126 ? (close / close[126] - 1) * 100 : 0.0
    c1y = bar_index >= 252 ? (close / close[252] - 1) * 100 : 0.0
    rng = (ta.highest(close, 21) / ta.lowest(close, 21) - 1) * 100
    tight    = math.abs(c1) <= 7 and rng <= 12
    extended = c1 > 15
    v50 = ta.sma(volume, 50)
    vr  = v50 > 0 ? ta.sma(volume, 10) / v50 : 1.0
    s = 10.0 * (a200 ? 1 : 0) + 10.0 * (a50 ? 1 : 0) + 5.0 * (cross ? 1 : 0) + 5.0 * (aboveLow >= 30 ? 1 : 0)
    s += math.max(0.0, 15.0 * (1 - math.min(offHigh, 25) / 25)) + math.max(0.0, 15.0 * (1 - math.min(math.abs(c1), 15) / 15))
    s += math.min(10.0, math.max(0.0, c6) / 5) + math.min(10.0, math.max(0.0, c1y) / 10)
    s += vr < 0.95 ? 10.0 : 0.0
    s += (offHigh <= 5 and tight) ? 5.0 : 0.0
    // 等級：0=A 1=B 2=C 3=D 4=E
    int g = 3
    if extended
        g := 4
    else if trendOK and offHigh <= 10 and tight
        g := 0
    else if offHigh <= 4 and c1 > 8
        g := 4
    else if trendOK and offHigh <= 20 and c3 > -5
        g := 1
    else if (a200 or aboveLow >= 20) and offHigh <= 30 and c1 > -10
        g := 2
    [math.min(s, 100.0), g, offHigh, aboveLow, c1, c3, rng, vr, trendOK, tight, extended, a50, a200, cross]

f_gradeTxt(g) => g == 0 ? "A · VCP 待突破" : g == 1 ? "B · 上升結構" : g == 2 ? "C · 基底修復中" : g == 3 ? "D · 趨勢弱" : "E · 突破延伸中"
f_gradeCol(g) => g == 0 ? #3FB68B : g == 1 ? #5CA3D6 : g == 2 ? #6B7885 : g == 3 ? #4A555F : #E5B15C

[cBreak, cRetr, cTime, cDv, cContr, cMa, hlOk, dvRatio, contrRatio, dHeld, brokeHi, ret21, nBot] =
     request.security(syminfo.tickerid, m3TF, f_cert7(), lookahead = barmerge.lookahead_off)
benchRet21 = request.security(bench, m3TF, bar_index >= 21 ? close / close[21] - 1 : 0.0,
     lookahead = barmerge.lookahead_off)
rs21 = ret21 - nz(benchRet21)
cRs  = f_clamp01(0.5 + rs21 / 0.2)
certTotal = 100 * (0.25 * cBreak + 0.10 * cRetr + 0.15 * cTime + 0.15 * cDv +
                   0.10 * cContr + 0.10 * cRs + 0.15 * cMa)

// ── 曲線 ──
// ── 曲線：只有「高確定性」(總分 ≥ 門檻) 的區段著色；其餘灰色、無填色、無背景 ──
hiCert  = certTotal >= certAlert
certCol = hiCert ? color.new(#3FB68B, 0) : color.new(#8B98A5, 35)
pCert = plot(certTotal, "確定性總分", color = certCol, linewidth = 2)
pThr  = plot(certAlert, "高確定性分界 (門檻)", color = color.new(#3FB68B, 30), linewidth = 1)
fill(pCert, pThr, color = hiCert ? color.new(#3FB68B, 70) : na, title = "高確定性區 (曲線 ≥ 門檻)")
bgcolor(hiCert ? color.new(#3FB68B, 88) : na, title = "高確定性背景")
plotshape(hiCert and not hiCert[1] ? certTotal : na, "進入高確定性", shape.labelup, location.absolute,
     color.new(#3FB68B, 0), text = "高確定", textcolor = color.white, size = size.small)
plot(showParts ? cBreak * 100 : na, "突破 25%", color = color.new(color.green, 45))
plot(showParts ? cRetr  * 100 : na, "回升 10%", color = color.new(color.lime, 45))
plot(showParts ? cTime  * 100 : na, "守底 15%", color = color.new(color.blue, 45))
plot(showParts ? cDv    * 100 : na, "量縮 15%", color = color.new(color.purple, 45))
plot(showParts ? cContr * 100 : na, "收縮 10%", color = color.new(color.orange, 45))
plot(showParts ? cRs    * 100 : na, "RS 10%",   color = color.new(color.red, 45))
plot(showParts ? cMa    * 100 : na, "均線 15%", color = color.new(color.gray, 45))
hline(50, "50", color = color.new(color.gray, 60))
bgcolor(showHLbg and hlOk ? color.new(#3FB68B, 94) : na, title = "一底高於一底 結構 (預設關閉)")

// ── 7 分項面板（本 pane 右側）──
var table tD = table.new(f_boxPos(boxPos), 3, 9, bgcolor = color.new(#ffffff, 5),
     frame_color = color.black, frame_width = 2, border_width = 1, border_color = color.new(color.black, 85))
var bool dInit = false
if showCert and barstate.islast
    if not dInit
        for cc = 0 to 2
            for rj = 0 to 8
                table.cell(tD, cc, rj, "")
        dInit := true
    hdrCol = hiCert ? color.new(#3FB68B, 10) : color.new(#6B7885, 10)   // 只有高確定性才上色
    table.cell(tD, 0, 0, "確定性", width = boxW * 0.40, height = boxH / 9, text_color = color.white, bgcolor = hdrCol, text_size = size.small)
    table.cell(tD, 1, 0, str.tostring(certTotal, "#.#"), width = boxW * 0.38, height = boxH / 9, text_color = color.white, bgcolor = hdrCol, text_size = size.small)
    table.cell(tD, 2, 0, hlOk ? "HL ✓ " + str.tostring(nBot) + " 底" : "無 HL", width = boxW * 0.22, height = boxH / 9, text_color = color.white,
         bgcolor = hdrCol, text_size = size.tiny)
    names = array.from("突破 25%", "回升 10%", "守底 15%", "量縮 15%", "收縮 10%", "RS 10%", "均線 15%")
    vals  = array.from(cBreak, cRetr, cTime, cDv, cContr, cRs, cMa)
    for i = 0 to 6
        v = array.get(vals, i)
        table.cell(tD, 0, i + 1, array.get(names, i), width = boxW * 0.40, height = boxH / 9, text_size = size.tiny, text_halign = text.align_left)
        table.cell(tD, 1, i + 1, f_bar(v, 8), width = boxW * 0.38, height = boxH / 9, text_size = size.tiny,
             text_color = v >= 0.7 ? #3FB68B : v >= 0.4 ? #E5B15C : #8B98A5)
        table.cell(tD, 2, i + 1, str.tostring(v * 100, "#"), width = boxW * 0.22, height = boxH / 9, text_size = size.tiny, text_halign = text.align_right)
    table.cell(tD, 0, 8, "量比(跌/漲) " + str.tostring(dvRatio, "#.##"), width = boxW * 0.40, height = boxH / 9, text_size = size.tiny, text_color = color.gray)
    table.cell(tD, 1, 8, "RS21 " + str.tostring(rs21 * 100, "+#.#") + "%", width = boxW * 0.38, height = boxH / 9, text_size = size.tiny, text_color = color.gray)
    table.cell(tD, 2, 8, hlOk ? "守底 " + str.tostring(dHeld) + "日" : "–", width = boxW * 0.22, height = boxH / 9, text_size = size.tiny, text_color = color.gray)

alertcondition(certTotal >= certAlert and certTotal[1] < certAlert, "確定性達門檻",
     "{{ticker}} 確定性總分升至門檻以上")

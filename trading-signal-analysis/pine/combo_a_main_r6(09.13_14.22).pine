//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  版本 r6(09:13_14:22)
//  R6-A  主圖：EMA9 Band Width Strategy
//
//  R6 套件 —— Pine 一個腳本只能佔一個 pane，故 R4 的單檔拆成四支，各佔一個 pane：
//     R6-A  主圖 (overlay)   EMA9 帶寬策略 + 進出場 + 狀態面板        combo_a_main_r6(09.13_14.22).pine
//     R6-B  下方 pane ①      MACD 柱狀圖 + 週期時鐘 (時鐘在最右邊)     combo_b_macd_clock_r6(09.13_14.22).pine
//     R6-C  下方 pane ②      VCP 指數曲線 0–100 + 等級                combo_c_vcp_r6(09.13_14.22).pine
//     R6-D  下方 pane ③      確定性指數曲線 0–100 + 7 分項            combo_d_cert_r6(09.13_14.22).pine
//  四支的計算邏輯與 R4 逐字相同，只改「畫在哪個 pane」與各自的呈現方式。
//
//  本檔內容：MODULE 2（EMA9 中線 ± 帶寬、擠壓突破 / 回踩進場、風控出場）。
//  M1 的日線週期與 M3 的 VCP／確定性仍在此計算，供「⑥ 模組整合」過濾與右上狀態面板使用，
//  但它們的圖形改由 R6-B / R6-C / R6-D 在各自的 pane 呈現，本檔不再畫時鐘與資訊框。
// ═══════════════════════════════════════════════════════════════════════════

strategy("R6-A EMA9 BW (main) r6(09:13_14:22)", shorttitle = "R6-A EMA9-BW",
     overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 20,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 1, pyramiding = 0, process_orders_on_close = true,
     max_labels_count = 500)


// ── M1 週期引擎（僅供過濾與面板；圖形在 R6-B）──
// ── M1 參數 ──
grpM = "M1 ① MACD (日線)"
m1src = input.source(close, "價格來源", group = grpM, display = display.none)
fast  = input.int(12, "快線 EMA", minval = 2, group = grpM, display = display.none)
slow  = input.int(26, "慢線 EMA", minval = 3, group = grpM, display = display.none)
sigL  = input.int(9,  "訊號線", minval = 2, group = grpM, display = display.none)
cycTF = input.timeframe("D", "週期計算時間框 (預設日線)", group = grpM, display = display.none)

grpC = "M1 ② 週期估算"
lookN  = input.int(8,  "平均週期長度取最近幾段", minval = 2, maxval = 50, group = grpC, display = display.none)
defLen = input.int(12, "尚無歷史時的預設週期長度 (日)", minval = 2, group = grpC, display = display.none)
lateAt = input.float(75, "進入尾段門檻 % (警報用)", minval = 50, maxval = 95, group = grpC, display = display.none)

grpK = "M1 ③ 時鐘外觀"
showClock = input.bool(true, "顯示時鐘", group = grpK, display = display.none)
posOpt = input.string("右下", "位置", options = ["左上", "右上", "左下", "右下"], group = grpK, display = display.none)
grid   = input.int(13, "解析度 (格數, 建議奇數 11–17)", minval = 9, maxval = 21, group = grpK, display = display.none)
cellW  = input.float(0.9, "格寬 (% 圖表寬)", minval = 0.3, step = 0.1, group = grpK, display = display.none)
cellH  = input.float(1.7, "格高 (% 圖表高)", minval = 0.5, step = 0.1, group = grpK, display = display.none)
tz     = input.string("America/New_York", "日期時區", group = grpK, display = display.none)
cUp    = input.color(color.new(#16a34a, 0),  "上昇周期色", group = grpK, display = display.none)
cDn    = input.color(color.new(#dc2626, 0),  "下跌周期色", group = grpK, display = display.none)
cHand  = input.color(color.new(#facc15, 0),  "指針色", group = grpK, display = display.none)
showBg  = input.bool(false, "主圖週期背景著色 (紅/綠；R6 預設關閉)", group = grpK, display = display.none)
showLbl = input.bool(true, "在切換處標註上一段週期長度", group = grpK, display = display.none)

// ── M1 日線週期引擎 (在 security 的日線環境中執行) ──
f_cycle() =>
    [m, s, h] = ta.macd(m1src, fast, slow, sigL)
    u  = h >= 0
    fl = bar_index > 0 and u != u[1]
    rs = h > h[1]
    var int   cs = 0
    var float ll = na
    var ul = array.new_float()
    var dl = array.new_float()
    if fl
        L = bar_index - cs
        ll := L
        a = u[1] ? ul : dl                 // 剛結束的是哪一種週期
        array.push(a, L)
        if array.size(a) > lookN
            array.shift(a)
        cs := bar_index
    el = bar_index - cs + 1
    au = array.size(ul) > 0 ? array.avg(ul) : defLen
    ad = array.size(dl) > 0 ? array.avg(dl) : defLen
    [m, s, h, u, fl, rs, el, au, ad, ll]

[macdL, sigLine, hist, up, flip, rising, elapsed, avgUp, avgDn, lastLen] =
     request.security(syminfo.tickerid, cycTF, f_cycle(), lookahead = barmerge.lookahead_off)

newDay  = timeframe.change(cycTF)          // 日線圖上每根都為 true；日內圖上每日第一根為 true
flipEvt = flip and newDay                  // 每個交易日最多觸發一次

expected = up ? avgUp : avgDn
progRaw  = elapsed / expected
prog     = math.min(progRaw, 0.97)
overdue  = progRaw > 1.0
late     = progRaw * 100 >= lateAt
lateEvt  = late and not late[1] and newDay

theta = up ? 270 + 180 * prog : 90 + 180 * prog        // 順時針、12 點鐘 = 0°
theta := theta >= 360 ? theta - 360 : theta

phaseTxt = up ? (rising ? "▲ 日線上昇周期 · 動能加速" : "▲ 日線上昇周期 · 動能減速")
              : (rising ? "▼ 日線下跌周期 · 跌勢減弱" : "▼ 日線下跌周期 · 跌勢加速")

bgcolor(showBg ? (up ? color.new(cUp, 94) : color.new(cDn, 94)) : na, title = "日線週期背景")


// ── M3 計算（僅供過濾與面板；曲線在 R6-C / R6-D）──
grpV = "M3 ① 資料來源"
m3TF  = input.timeframe("D", "計算時間框 (預設日線)", group = grpV, display = display.none)
bench = input.symbol("SPY", "相對強度 (RS) 基準", group = grpV, display = display.none)

grpW = "M3 ② 門檻"
certAlert = input.float(70, "確定性警報門檻 (≥)", minval = 0, maxval = 100, group = grpW, display = display.none)

f_clamp01(x) => math.max(0.0, math.min(1.0, x))

f_pos(s) => s == "左上" ? position.top_left : s == "左中" ? position.middle_left : s == "左下" ? position.bottom_left :
     s == "右上" ? position.top_right : s == "右中" ? position.middle_right : position.bottom_right

f_bar(v, n) =>          // 0–1 → n 格文字進度條
    string b = ""
    k = math.round(v * n)
    for i = 1 to n
        b += i <= k ? "█" : "░"
    b

// ── 3-A 確定性 7 項 (在日線環境執行) ──
f_cert7() =>
    // 均線排列：價>MA20 (0.4) / MA20>MA50 (0.3) / MA50 較 10 日前上升 (0.3)
    ma20 = ta.sma(close, 20)
    ma50 = ta.sma(close, 50)
    f1 = close > ma20
    f2 = ma20 > ma50
    f3 = ma50 > ma50[10]
    sMa = 0.4 * (f1 ? 1.0 : 0.0) + 0.3 * (f2 ? 1.0 : 0.0) + 0.3 * (f3 ? 1.0 : 0.0)

    // 量縮：近 15 日「跌日均量 ÷ 漲日均量」，越低越好
    float upV = 0.0
    float dnV = 0.0
    int   upN = 0
    int   dnN = 0
    for k = 0 to 14
        if close[k] > close[k + 1]
            upV += volume[k]
            upN += 1
        else if close[k] < close[k + 1]
            dnV += volume[k]
            dnN += 1
    dv  = (upN > 0 and dnN > 0 and upV > 0) ? (dnV / dnN) / (upV / upN) : 1.0
    sDv = f_clamp01((1.4 - dv) / 0.8)

    // 底部偵測：±3 根局部最低收盤，3 根內重複取較低者；由舊到新存入陣列 (offset 44 → 3)
    bOff = array.new_int()
    bPx  = array.new_float()
    for k = 44 to 3
        c0 = close[k]
        if not na(c0) and not na(close[k + 3])
            isMin = true
            for j = -3 to 3
                if close[k + j] < c0
                    isMin := false
            if isMin and close[k + 3] > c0 and close[k - 3] > c0
                nb0 = array.size(bOff)
                bool dup = false
                if nb0 > 0
                    dup := array.get(bOff, nb0 - 1) - k <= 3     // 3 根內重複
                if dup
                    if c0 < array.get(bPx, nb0 - 1)
                        array.set(bOff, nb0 - 1, k)
                        array.set(bPx,  nb0 - 1, c0)
                else
                    array.push(bOff, k)
                    array.push(bPx,  c0)

    // 一底高於一底：窗內 ≥2 個底、價格嚴格遞增、最近一底在 25 根內
    nb = array.size(bOff)
    bool hlOk = false
    if nb >= 2                                   // 先確認陣列非空再取值 (Pine 的 and 不短路)
        hlOk := array.get(bOff, nb - 1) <= 24
        if hlOk
            for k = 1 to nb - 1
                if array.get(bPx, k) <= array.get(bPx, k - 1)
                    hlOk := false

    float sBreak = 0.0
    float sRetr  = 0.0
    float sTime  = 0.0
    float sContr = 0.0
    float contr  = na
    int   dHeld  = 0
    bool  broke  = false
    if hlOk
        oP = array.get(bOff, nb - 2)
        oL = array.get(bOff, nb - 1)
        pL = array.get(bPx,  nb - 1)
        // H_mid：兩底之間的最高收盤
        hMid = close[oP]
        for k = oL + 1 to oP
            hMid := math.max(hMid, close[k])
        // 最近一底之後的最高 / 最低收盤
        postHigh = close
        postMin  = close
        for k = 0 to oL - 1
            postHigh := math.max(postHigh, close[k])
            postMin  := math.min(postMin,  close[k])
        broke   := postHigh > hMid
        progress = hMid > pL ? (close - pL) / (hMid - pL) : 1.0
        sBreak  := broke ? 1.0 : 0.6 * f_clamp01(progress)      // 突破 (已破前高=1)
        sRetr   := f_clamp01(progress)                           // 回升 (跌幅收復比例)
        dHeld   := oL
        undercut = postMin < pL * 0.999
        sTime   := math.min(1.0, dHeld / 15.0) * (undercut ? 0.25 : 1.0)   // 守底天數 (跌破低點 ×0.25)
        // 收縮：各底回檔深度，最後一段 ÷ 第一段 (越小越好)
        depths = array.new_float()
        for k = 0 to nb - 1
            bo = array.get(bOff, k)
            bp = array.get(bPx,  k)
            hi = bp
            if k == 0
                for j = bo + 1 to bo + 10
                    if not na(close[j])
                        hi := math.max(hi, close[j])
            else
                po = array.get(bOff, k - 1)
                for j = bo + 1 to po
                    hi := math.max(hi, close[j])
            if hi > bp
                array.push(depths, (hi - bp) / hi)
        nd = array.size(depths)
        // 用 if 而非 ternary：Pine 的 ?: 兩邊都會求值，空陣列會在此越界並中斷整根 K 線的執行
        contr := 1.0
        if nd >= 2
            d0 = array.get(depths, 0)
            if d0 > 1e-4
                contr := array.get(depths, nd - 1) / d0
        sContr := f_clamp01(1.0 - contr)

    ret21 = bar_index >= 21 ? close / close[21] - 1 : 0.0
    [sBreak, sRetr, sTime, sDv, sContr, sMa, hlOk, dv, contr, dHeld, broke, ret21, nb]

// ── 3-B VCP 分數 / 等級 (vcp_classify，在日線環境執行) ──
f_vcp() =>
    p = close
    hi52 = ta.highest(close, 252)
    lo52 = ta.lowest(close, 252)
    hiN  = ta.highest(close, math.min(252, bar_index + 1))
    loN  = ta.lowest(close,  math.min(252, bar_index + 1))
    hiY  = na(hi52) ? hiN : hi52
    loY  = na(lo52) ? loN : lo52
    offHigh  = (hiY - p) / hiY * 100
    aboveLow = loY > 0 ? (p - loY) / loY * 100 : 0.0
    ma50  = ta.sma(close, 50)
    ma200 = ta.sma(close, 200)
    has50  = not na(ma50)
    has200 = not na(ma200)
    a50raw = has50 and p > ma50
    // 無 MA200 時以「站上 MA50 且距高 ≤25%」代理長期趨勢 (同原算法)
    a200  = has200 ? p > ma200 : (has50 ? (a50raw and offHigh <= 25) : (aboveLow >= 25 and offHigh <= 20))
    cross = has200 ? (has50 ? ma50 > ma200 : a200) : a200
    a50   = has50 ? a50raw : a200
    trendOK = a50 and a200 and cross and aboveLow >= 30 and offHigh <= 25
    c1  = bar_index >= 21  ? (close / close[21]  - 1) * 100 : 0.0
    c3  = bar_index >= 63  ? (close / close[63]  - 1) * 100 : c1
    c6  = bar_index >= 126 ? (close / close[126] - 1) * 100 : 0.0
    c1y = bar_index >= 252 ? (close / close[252] - 1) * 100 : 0.0
    rng = (ta.highest(close, 21) / ta.lowest(close, 21) - 1) * 100
    tight    = math.abs(c1) <= 7 and rng <= 12
    extended = c1 > 15
    v50 = ta.sma(volume, 50)
    vr  = v50 > 0 ? ta.sma(volume, 10) / v50 : 1.0
    s = 10.0 * (a200 ? 1 : 0) + 10.0 * (a50 ? 1 : 0) + 5.0 * (cross ? 1 : 0) + 5.0 * (aboveLow >= 30 ? 1 : 0)
    s += math.max(0.0, 15.0 * (1 - math.min(offHigh, 25) / 25)) + math.max(0.0, 15.0 * (1 - math.min(math.abs(c1), 15) / 15))
    s += math.min(10.0, math.max(0.0, c6) / 5) + math.min(10.0, math.max(0.0, c1y) / 10)
    s += vr < 0.95 ? 10.0 : 0.0
    s += (offHigh <= 5 and tight) ? 5.0 : 0.0
    // 等級：0=A 1=B 2=C 3=D 4=E
    int g = 3
    if extended
        g := 4
    else if trendOK and offHigh <= 10 and tight
        g := 0
    else if offHigh <= 4 and c1 > 8
        g := 4
    else if trendOK and offHigh <= 20 and c3 > -5
        g := 1
    else if (a200 or aboveLow >= 20) and offHigh <= 30 and c1 > -10
        g := 2
    [math.min(s, 100.0), g, offHigh, aboveLow, c1, c3, rng, vr, trendOK, tight, extended, a50, a200, cross]

f_gradeTxt(g) => g == 0 ? "A · VCP 待突破" : g == 1 ? "B · 上升結構" : g == 2 ? "C · 基底修復中" : g == 3 ? "D · 趨勢弱" : "E · 突破延伸中"
f_gradeCol(g) => g == 0 ? #3FB68B : g == 1 ? #5CA3D6 : g == 2 ? #6B7885 : g == 3 ? #4A555F : #E5B15C

[cBreak, cRetr, cTime, cDv, cContr, cMa, hlOk, dvRatio, contrRatio, dHeld, brokeHi, ret21, nBot] =
     request.security(syminfo.tickerid, m3TF, f_cert7(), lookahead = barmerge.lookahead_off)
benchRet21 = request.security(bench, m3TF, bar_index >= 21 ? close / close[21] - 1 : 0.0, lookahead = barmerge.lookahead_off)
rs21 = ret21 - nz(benchRet21)
cRs  = f_clamp01(0.5 + rs21 / 0.2)                 // 相對強度：領先基準 +10% → 1，落後 10% → 0
certTotal = 100 * (0.25 * cBreak + 0.10 * cRetr + 0.15 * cTime + 0.15 * cDv + 0.10 * cContr + 0.10 * cRs + 0.15 * cMa)

[vcpScore, vcpGrade, offHigh, aboveLow, chg1m, chg3m, rng21, volRatio, trendOK, tightB, extendedB, a50B, a200B, crossB] =
     request.security(syminfo.tickerid, m3TF, f_vcp(), lookahead = barmerge.lookahead_off)

plot(certTotal, "M3-A 確定性總分", color = color.new(color.teal, 0), display = display.data_window)
plot(vcpScore,  "M3-B VCP 分數",   color = color.new(color.orange, 0), display = display.data_window)
plot(vcpGrade,  "M3-B VCP 等級 (0=A…4=E)", color = color.gray, display = display.data_window)


// ── MODULE 2：策略本體 ──
grpB = "M2 ① 帶狀通道"
src      = input.source(close, "價格來源", group = grpB, display = display.none)
len      = input.int(9, "EMA 週期 (中線)", minval = 2, group = grpB, display = display.none)
bandMode = input.string("StdDev", "帶寬計算方式", options = ["StdDev", "ATR"], group = grpB, display = display.none)
mult     = input.float(2.0, "StdDev 倍數", step = 0.1, minval = 0.5, group = grpB, display = display.none)
atrMult  = input.float(1.5, "ATR 倍數", step = 0.1, minval = 0.5, group = grpB, display = display.none)

grpS = "M2 ② 擠壓 (Squeeze) 偵測"
bwLook = input.int(60, "Band Width 回看期 (找 N 期最低)", minval = 10, group = grpS, display = display.none)
sqzTol = input.float(15, "擠壓容忍度 % (BW ≤ 最低 × (1+tol))", step = 1, minval = 0, group = grpS, display = display.none)
sqzWin = input.int(8, "擠壓後幾根 K 內突破才有效", minval = 1, group = grpS, display = display.none)

grpE = "M2 ③ 進場"
useBreak   = input.bool(true, "A) 擠壓後突破上軌", group = grpE, display = display.none)
usePull    = input.bool(true, "B) 順勢回踩 EMA9 站回", group = grpE, display = display.none)
allowShort = input.bool(false, "允許做空 (鏡像規則)", group = grpE, display = display.none)
useVol     = input.bool(true, "量能過濾：量 > 20日均量 ×", inline = "v", group = grpE, display = display.none)
volX       = input.float(1.5, "", step = 0.1, minval = 0.5, inline = "v", group = grpE, display = display.none)
useMacd    = input.bool(true, "MACD 過濾 (多: MACD>0 / 空: MACD<0)", group = grpE, display = display.none)
useTrend   = input.bool(true, "大趨勢過濾 (多: 價>EMA21 / 空: 價<EMA21)", group = grpE, display = display.none)

grpX = "M2 ④ 出場 / 風控"
rr          = input.float(2.0, "止盈 R 倍數 (0 = 不設止盈)", step = 0.5, minval = 0, group = grpX, display = display.none)
midExit     = input.bool(true, "收盤跌破/站回中線即出場 (移動出場)", group = grpX, display = display.none)
midBars     = input.int(1, "需連續幾根 K 收在中線另一側", minval = 1, group = grpX, display = display.none)
useRiskSize = input.bool(true, "依風險 % 計算股數 (關閉 = 用預設 % 權益)", group = grpX, display = display.none)
riskPct     = input.float(1.0, "每筆風險 % 帳戶", step = 0.25, minval = 0.1, group = grpX, display = display.none)

grpD = "M2 ⑤ 回測區間"
startT  = input.time(timestamp("2023-01-01T00:00:00"), "開始", group = grpD, display = display.none)
endT    = input.time(timestamp("2030-12-31T00:00:00"), "結束", group = grpD, display = display.none)
inRange = time >= startT and time <= endT

grpI = "⑥ 模組整合 (M1 → M2)"
useDailyCycle = input.bool(false, "依日線週期過濾：多單只在日線上昇周期 / 空單只在下跌周期", group = grpI, display = display.none)
avoidLate     = input.bool(false, "日線週期已進入尾段 (>門檻%) 時不再新開倉", group = grpI, display = display.none)
useVcpGrade   = input.bool(false, "M3：只在 VCP 等級 A/B 時做多", group = grpI, display = display.none)
minCert       = input.float(0, "M3：確定性總分 ≥ 此值才做多 (0 = 不過濾)", minval = 0, maxval = 100, step = 5, group = grpI, display = display.none)

// ── ⑦ 版面（四支 R6 腳本請設同一 boxW，四個資訊框即等寬、右緣對齊）──
grpL   = "⑦ 版面 (四個 pane 統一)"
boxW   = input.float(18, "資訊框寬度 (% 圖表寬；四支腳本設同值)", minval = 8, maxval = 45, step = 0.5, group = grpL, display = display.none)
boxH   = input.float(100, "資訊框高度 (% 本 pane 高；100 = 撐滿)", minval = 30, maxval = 100, step = 5, group = grpL, display = display.none)
boxPos = input.string("右中", "垂直位置 (高度 <100 時才有差別)", options = ["右上", "右中", "右下"], group = grpL, display = display.none)
f_boxPos(s) => s == "右上" ? position.top_right : s == "右下" ? position.bottom_right : position.middle_right
// 備註框：淺色底 + 黑字，放在錨點上方 (above) 或下方，與曲線同一座標系 (縮放/捲動同步)，虛線指回被標註的點
f_note(x, yAnchor, yBox, txt, col, above) =>
    lb = label.new(x, yBox, txt, style = above ? label.style_label_down : label.style_label_up,
         color = color.new(col, 40), textcolor = color.black, size = size.small)
    ln = line.new(x, yAnchor, x, yBox, color = color.new(col, 25), style = line.style_dotted, width = 1)
    [lb, ln]

// ── M2 指標 ──
basis = ta.ema(src, len)
dev   = bandMode == "StdDev" ? mult * ta.stdev(src, len) : atrMult * ta.atr(len)
upper = basis + dev
lower = basis - dev
bw    = (upper - lower) / basis * 100            // Band Width %
bwLow = ta.lowest(bw, bwLook)

squeeze   = bw <= bwLow * (1 + sqzTol / 100)     // 帶寬處於 N 期最低附近
sinceSqz  = ta.barssince(squeeze)
recentSqz = not na(sinceSqz) and sinceSqz <= sqzWin
expanding = bw > bw[1]                           // 帶寬開始擴張

volAvg = ta.sma(volume, 20)
volOK  = not useVol or volume > volAvg * volX

[m2_macd, m2_sig, m2_hist] = ta.macd(close, 12, 26, 9)   // M2 自己的 (圖表時間框) MACD
macdLongOK  = not useMacd or m2_macd > 0
macdShortOK = not useMacd or m2_macd < 0

ema21        = ta.ema(close, 21)
trendLongOK  = not useTrend or close > ema21
trendShortOK = not useTrend or close < ema21

basisUp = basis > basis[2]
basisDn = basis < basis[2]

// 交叉判斷提到全域計算 (避免 CW10002：ta.* 在條件式內可能不每根執行)
crossUp = ta.crossover(close, upper)
crossDn = ta.crossunder(close, lower)

// 模組整合：日線週期方向 / 尾段過濾 (預設關閉，關閉時恆為 true)
dailyLongOK  = not useDailyCycle or up
dailyShortOK = not useDailyCycle or not up
notLateOK    = not avoidLate or not late
vcpOK        = not useVcpGrade or vcpGrade <= 1          // A 或 B
certOK       = minCert <= 0 or certTotal >= minCert

// ── M2 訊號 ──
flat = strategy.position_size == 0

longBreak = useBreak and recentSqz and crossUp and expanding
longPull  = usePull and basisUp and low <= basis and close > basis and close > open and close > close[1]
longSig   = inRange and flat and (longBreak or longPull) and volOK and macdLongOK and trendLongOK and dailyLongOK and notLateOK and vcpOK and certOK

shortBreak = useBreak and recentSqz and crossDn and expanding
shortPull  = usePull and basisDn and high >= basis and close < basis and close < open and close < close[1]
shortSig   = allowShort and inRange and flat and (shortBreak or shortPull) and volOK and macdShortOK and trendShortOK and dailyShortOK and notLateOK

// ── M2 倉位 / 止損 / 止盈 ──
var float stopPx = na
var float tpPx   = na

qtyByRisk(entryPx, stopPrice) =>
    perShare = math.abs(entryPx - stopPrice)
    riskCash = strategy.equity * riskPct / 100
    perShare > 0 ? math.max(1, math.floor(riskCash / perShare)) : 1

if longSig
    stopPx := math.min(lower, low)                       // 下軌與本 K 低點取低者
    tpPx   := rr > 0 ? close + rr * (close - stopPx) : na
    cmt = longBreak ? "L 擠壓突破" : "L 回踩EMA9"
    if useRiskSize
        strategy.entry("L", strategy.long, qty = qtyByRisk(close, stopPx), comment = cmt)
    else
        strategy.entry("L", strategy.long, comment = cmt)
    alert("EMA9-BW 做多 " + syminfo.ticker + " @" + str.tostring(close, format.mintick) +
         "  止損 " + str.tostring(stopPx, format.mintick) +
         (rr > 0 ? "  止盈 " + str.tostring(tpPx, format.mintick) : ""), alert.freq_once_per_bar_close)

if shortSig
    stopPx := math.max(upper, high)
    tpPx   := rr > 0 ? close - rr * (stopPx - close) : na
    cmt = shortBreak ? "S 擠壓跌破" : "S 反彈EMA9"
    if useRiskSize
        strategy.entry("S", strategy.short, qty = qtyByRisk(close, stopPx), comment = cmt)
    else
        strategy.entry("S", strategy.short, comment = cmt)
    alert("EMA9-BW 做空 " + syminfo.ticker + " @" + str.tostring(close, format.mintick) +
         "  止損 " + str.tostring(stopPx, format.mintick), alert.freq_once_per_bar_close)

// 固定止損 + 止盈 (OCO)
if strategy.position_size > 0
    strategy.exit("L-exit", from_entry = "L", stop = stopPx, limit = tpPx)
if strategy.position_size < 0
    strategy.exit("S-exit", from_entry = "S", stop = stopPx, limit = tpPx)

// 移動出場：收盤跌破 (多) / 站回 (空) 中線
var int belowCnt = 0
var int aboveCnt = 0
belowCnt := close < basis ? belowCnt + 1 : 0
aboveCnt := close > basis ? aboveCnt + 1 : 0

if midExit and strategy.position_size > 0 and belowCnt >= midBars
    strategy.close("L", comment = "跌破EMA9")
    alert("EMA9-BW 平多 " + syminfo.ticker + " 收盤跌破 EMA9", alert.freq_once_per_bar_close)
if midExit and strategy.position_size < 0 and aboveCnt >= midBars
    strategy.close("S", comment = "站回EMA9")
    alert("EMA9-BW 平空 " + syminfo.ticker + " 收盤站回 EMA9", alert.freq_once_per_bar_close)

// ── M2 繪圖 ──
pB = plot(basis, "EMA9 中線", color = color.new(color.orange, 0), linewidth = 2, display = display.pane + display.data_window + display.price_scale)
pU = plot(upper, "上軌", color = color.new(color.teal, 55), linewidth = 1, display = display.pane + display.data_window + display.price_scale)
pL = plot(lower, "下軌", color = color.new(color.teal, 55), linewidth = 1, display = display.pane + display.data_window + display.price_scale)
fill(pU, pL, color = squeeze ? color.new(color.yellow, 88) : color.new(color.teal, 96), title = "通道 (黃 = 擠壓)")
plot(ema21, "EMA21 (趨勢過濾)", color = color.new(color.gray, 20), linewidth = 3, display = display.pane + display.data_window + display.price_scale)
plot(bw, "Band Width %", color = color.purple, display = display.data_window)
plot(bwLow, "Band Width N 期最低", color = color.gray, display = display.data_window)

plotshape(longSig,  "做多訊號", shape.triangleup,   location.belowbar, color.green, size = size.small, text = "多")
plotshape(shortSig, "做空訊號", shape.triangledown, location.abovebar, color.red,   size = size.small, text = "空")
plot(strategy.position_size != 0 ? stopPx : na, "止損線", color = color.red,   style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window + display.price_scale)
plot(strategy.position_size != 0 ? tpPx   : na, "止盈線", color = color.green, style = plot.style_linebr, linewidth = 1, display = display.pane + display.data_window + display.price_scale)

// ── ⑧ 主力大單日（成交量柱本身畫在 R6-C pane，主圖只留 ◆ 標記 / 狀態列 / 警報）──
// 主力大單 = 量 ≥ bigX × 均量，且收在當日區間上緣 (買入) / 下緣 (賣出)。
grpVol  = "⑧ 主力大單 (成交量柱在 R6-C)"
volLen  = input.int(50, "均量期數 (與 R6-C 設同值)", minval = 5, group = grpVol, display = display.none)
bigX    = input.float(2.0, "主力大單門檻 (× 均量)", minval = 1.2, step = 0.1, group = grpVol, display = display.none)
bigPos  = input.float(0.6, "主力買入：收盤位於當日區間 ≥ (0.5–1)；賣出反之", minval = 0.5, maxval = 1, step = 0.05, group = grpVol, display = display.none)
markBig = input.bool(true, "K 線旁加 ◆ 標記 (藍 = 主買、橙 = 主賣)", group = grpVol, display = display.none)
cBuy    = input.color(#2563eb, "主力買入色", group = grpVol, display = display.none)
cSell   = input.color(#f97316, "主力賣出色", group = grpVol, display = display.none)

vAvg    = ta.sma(volume, volLen)
rngPos  = high != low ? (close - low) / (high - low) : 0.5
bigVol  = volume >= vAvg * bigX
bigBuy  = bigVol and close > open and rngPos >= bigPos
bigSell = bigVol and close < open and rngPos <= 1 - bigPos
nBuy20  = math.sum(bigBuy  ? 1 : 0, 20)
nSell20 = math.sum(bigSell ? 1 : 0, 20)
plotshape(markBig and bigBuy,  "主力大單買入日", shape.diamond, location.belowbar, cBuy,  size = size.tiny)
plotshape(markBig and bigSell, "主力大單賣出日", shape.diamond, location.abovebar, cSell, size = size.tiny)
plot(volume, "成交量", color = bigBuy ? cBuy : bigSell ? cSell : color.gray, display = display.data_window)
plot(vAvg,   "均量",   color = color.gray, display = display.data_window)

// M2 狀態面板 (貼右；寬度/高度/位置由 ⑦ 版面 決定，與 R6-B/C/D 對齊)
var tbl = table.new(f_boxPos(boxPos), 2, 10, bgcolor = color.new(#ffffff, 5),
     frame_color = color.black, frame_width = 2, border_width = 1, border_color = color.new(color.black, 85))
if barstate.islast
    table.cell(tbl, 0, 0, "Band Width %", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 0, str.tostring(bw, "#.##"), width = boxW * 0.45, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 0, 1, "N期最低 BW", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 1, str.tostring(bwLow, "#.##"), width = boxW * 0.45, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 0, 2, "擠壓中", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 2, squeeze ? "是 ⚠" : (recentSqz ? "剛結束" : "否"), width = boxW * 0.45, height = boxH / 10, text_size = size.small, bgcolor = squeeze ? color.new(color.yellow, 60) : na)
    table.cell(tbl, 0, 3, "帶寬方向", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 3, expanding ? "擴張 ↑" : "收縮 ↓", width = boxW * 0.45, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 0, 4, "MACD (圖表TF)", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 4, m2_macd > 0 ? "綠燈" : "紅燈", width = boxW * 0.45, height = boxH / 10, text_size = size.small, bgcolor = m2_macd > 0 ? color.new(color.green, 70) : color.new(color.red, 70))
    table.cell(tbl, 0, 5, "EMA9 斜率", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 5, basisUp ? "上升" : (basisDn ? "下降" : "走平"), width = boxW * 0.45, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 0, 6, "日線週期 (R6-B)", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 6, (up ? "上昇 " : "下跌 ") + str.tostring(progRaw * 100, "#") + "%" + (useDailyCycle ? " ·過濾中" : ""), width = boxW * 0.45, height = boxH / 10,
         text_size = size.small, bgcolor = up ? color.new(cUp, 70) : color.new(cDn, 70))
    table.cell(tbl, 0, 7, "VCP 等級 (R6-C)", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 7, f_gradeTxt(vcpGrade) + " · " + str.tostring(vcpScore, "#") + (useVcpGrade ? " ·過濾中" : ""), width = boxW * 0.45, height = boxH / 10, text_size = size.small, bgcolor = color.new(f_gradeCol(vcpGrade), 60))
    table.cell(tbl, 0, 8, "確定性 (R6-D)", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 8, str.tostring(certTotal, "#.#") + (minCert > 0 ? " ·門檻 " + str.tostring(minCert, "#") : ""), width = boxW * 0.45, height = boxH / 10, text_size = size.small, bgcolor = certTotal >= certAlert ? color.new(#3FB68B, 60) : na)

    table.cell(tbl, 0, 9, "主力大單 (20日)", width = boxW * 0.55, height = boxH / 10, text_size = size.small)
    table.cell(tbl, 1, 9, "買 " + str.tostring(nBuy20) + " · 賣 " + str.tostring(nSell20) + (bigBuy ? " ·今日主買" : bigSell ? " ·今日主賣" : ""),
         width = boxW * 0.45, height = boxH / 10, text_size = size.small,
         bgcolor = bigBuy ? color.new(cBuy, 60) : bigSell ? color.new(cSell, 60) : na)

// ── M2 警報 ──
alertcondition(longSig,  "M2 EMA9-BW 做多訊號", "{{ticker}} EMA9 帶寬策略做多訊號 @{{close}}")
alertcondition(shortSig, "M2 EMA9-BW 做空訊號", "{{ticker}} EMA9 帶寬策略做空訊號 @{{close}}")
alertcondition(squeeze and not squeeze[1], "M2 EMA9-BW 擠壓開始", "{{ticker}} 帶寬進入擠壓，留意突破")
alertcondition(bigBuy,  "⑧ 主力大單買入日", "{{ticker}} 成交量 ≥ 均量 ×門檻 且收在區間上緣 — 主力大單買入")
alertcondition(bigSell, "⑧ 主力大單賣出日", "{{ticker}} 成交量 ≥ 均量 ×門檻 且收在區間下緣 — 主力大單賣出")

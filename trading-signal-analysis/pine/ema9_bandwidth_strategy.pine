//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  EMA9 Band Width Strategy  —  中短線波段策略
//
//  概念：Bollinger Band = 20 SMA ± 2σ；本策略把中線換成反應更快的 9 EMA：
//        中線  basis = EMA(close, 9)
//        上下軌 = basis ± 倍數 × 標準差(9)   [或改用 ATR 倍數]
//        Band Width (BW) = (上軌 − 下軌) / 中線 × 100%
//        BW 收縮到 N 期最低附近 = 「擠壓 (Squeeze)」，隨後的擴張 = 波段啟動
//
//  進場 (二選一或並用)：
//        A) 擠壓突破：最近 N 根內出現擠壓 → 收盤突破上軌 + BW 擴張 + 放量
//        B) 順勢回踩：中線上升 → 價格回踩 EMA9 後收盤站回 (陽線 + 高於前收)
//  過濾：MACD 綠燈 (>0) / 價格在 EMA21 之上 / 量 > 20 日均量 × 倍數
//  出場：初始止損 = 進場 K 的下軌與低點取低者
//        止盈 = R 倍數 (預設 2R)
//        移動出場 = 收盤跌破 EMA9 中線 (可設連續幾根)
//  倉位：依「每筆風險 % × 帳戶 ÷ 止損距離」自動計算股數 (可關閉改用 % 權益)
//
//  建議週期：日線 / 4H (中短線波段)；1H 亦可但需調高量能倍數
//  用法：TradingView → Pine Editor 貼上 → 加入圖表 → 策略測試器看績效
//        → 右上「警報」選「任何 alert() 函數呼叫」即可推播進出場
// ═══════════════════════════════════════════════════════════════════════════
strategy("EMA9 Band Width Strategy", shorttitle = "EMA9-BW",
     overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 20,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 1, pyramiding = 0, process_orders_on_close = true,
     max_labels_count = 500)

// ───────────────────────────── 參數 ─────────────────────────────
grpB = "① 帶狀通道"
src      = input.source(close, "價格來源", group = grpB)
len      = input.int(9, "EMA 週期 (中線)", minval = 2, group = grpB)
bandMode = input.string("StdDev", "帶寬計算方式", options = ["StdDev", "ATR"], group = grpB)
mult     = input.float(2.0, "StdDev 倍數", step = 0.1, minval = 0.5, group = grpB)
atrMult  = input.float(1.5, "ATR 倍數", step = 0.1, minval = 0.5, group = grpB)

grpS = "② 擠壓 (Squeeze) 偵測"
bwLook = input.int(60, "Band Width 回看期 (找 N 期最低)", minval = 10, group = grpS)
sqzTol = input.float(15, "擠壓容忍度 % (BW ≤ 最低 × (1+tol))", step = 1, minval = 0, group = grpS)
sqzWin = input.int(8, "擠壓後幾根 K 內突破才有效", minval = 1, group = grpS)

grpE = "③ 進場"
useBreak   = input.bool(true, "A) 擠壓後突破上軌", group = grpE)
usePull    = input.bool(true, "B) 順勢回踩 EMA9 站回", group = grpE)
allowShort = input.bool(false, "允許做空 (鏡像規則)", group = grpE)
useVol     = input.bool(true, "量能過濾：量 > 20日均量 ×", inline = "v", group = grpE)
volX       = input.float(1.5, "", step = 0.1, minval = 0.5, inline = "v", group = grpE)
useMacd    = input.bool(true, "MACD 過濾 (多: MACD>0 / 空: MACD<0)", group = grpE)
useTrend   = input.bool(true, "大趨勢過濾 (多: 價>EMA21 / 空: 價<EMA21)", group = grpE)

grpX = "④ 出場 / 風控"
rr          = input.float(2.0, "止盈 R 倍數 (0 = 不設止盈)", step = 0.5, minval = 0, group = grpX)
midExit     = input.bool(true, "收盤跌破/站回中線即出場 (移動出場)", group = grpX)
midBars     = input.int(1, "需連續幾根 K 收在中線另一側", minval = 1, group = grpX)
useRiskSize = input.bool(true, "依風險 % 計算股數 (關閉 = 用預設 % 權益)", group = grpX)
riskPct     = input.float(1.0, "每筆風險 % 帳戶", step = 0.25, minval = 0.1, group = grpX)

grpD = "⑤ 回測區間"
startT  = input.time(timestamp("2023-01-01T00:00:00"), "開始", group = grpD)
endT    = input.time(timestamp("2030-12-31T00:00:00"), "結束", group = grpD)
inRange = time >= startT and time <= endT

// ───────────────────────────── 指標 ─────────────────────────────
basis = ta.ema(src, len)
dev   = bandMode == "StdDev" ? mult * ta.stdev(src, len) : atrMult * ta.atr(len)
upper = basis + dev
lower = basis - dev
bw    = (upper - lower) / basis * 100            // Band Width %
bwLow = ta.lowest(bw, bwLook)

squeeze   = bw <= bwLow * (1 + sqzTol / 100)     // 帶寬處於 N 期最低附近
sinceSqz  = ta.barssince(squeeze)
recentSqz = not na(sinceSqz) and sinceSqz <= sqzWin
expanding = bw > bw[1]                           // 帶寬開始擴張

volAvg = ta.sma(volume, 20)
volOK  = not useVol or volume > volAvg * volX

[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
macdLongOK  = not useMacd or macdL > 0
macdShortOK = not useMacd or macdL < 0

ema21        = ta.ema(close, 21)
trendLongOK  = not useTrend or close > ema21
trendShortOK = not useTrend or close < ema21

basisUp = basis > basis[2]
basisDn = basis < basis[2]

// 交叉判斷提到全域計算 (避免 CW10002：ta.* 在條件式內可能不每根執行)
crossUp = ta.crossover(close, upper)
crossDn = ta.crossunder(close, lower)

// ───────────────────────────── 訊號 ─────────────────────────────
flat = strategy.position_size == 0

longBreak = useBreak and recentSqz and crossUp and expanding
longPull  = usePull and basisUp and low <= basis and close > basis and close > open and close > close[1]
longSig   = inRange and flat and (longBreak or longPull) and volOK and macdLongOK and trendLongOK

shortBreak = useBreak and recentSqz and crossDn and expanding
shortPull  = usePull and basisDn and high >= basis and close < basis and close < open and close < close[1]
shortSig   = allowShort and inRange and flat and (shortBreak or shortPull) and volOK and macdShortOK and trendShortOK

// ───────────────────────────── 倉位 / 止損 / 止盈 ─────────────────────────────
var float stopPx = na
var float tpPx   = na

qtyByRisk(entryPx, stopPrice) =>
    perShare = math.abs(entryPx - stopPrice)
    riskCash = strategy.equity * riskPct / 100
    perShare > 0 ? math.max(1, math.floor(riskCash / perShare)) : 1

if longSig
    stopPx := math.min(lower, low)                       // 下軌與本 K 低點取低者
    tpPx   := rr > 0 ? close + rr * (close - stopPx) : na
    cmt = longBreak ? "L 擠壓突破" : "L 回踩EMA9"
    if useRiskSize
        strategy.entry("L", strategy.long, qty = qtyByRisk(close, stopPx), comment = cmt)
    else
        strategy.entry("L", strategy.long, comment = cmt)
    alert("EMA9-BW 做多 " + syminfo.ticker + " @" + str.tostring(close, format.mintick) +
         "  止損 " + str.tostring(stopPx, format.mintick) +
         (rr > 0 ? "  止盈 " + str.tostring(tpPx, format.mintick) : ""), alert.freq_once_per_bar_close)

if shortSig
    stopPx := math.max(upper, high)
    tpPx   := rr > 0 ? close - rr * (stopPx - close) : na
    cmt = shortBreak ? "S 擠壓跌破" : "S 反彈EMA9"
    if useRiskSize
        strategy.entry("S", strategy.short, qty = qtyByRisk(close, stopPx), comment = cmt)
    else
        strategy.entry("S", strategy.short, comment = cmt)
    alert("EMA9-BW 做空 " + syminfo.ticker + " @" + str.tostring(close, format.mintick) +
         "  止損 " + str.tostring(stopPx, format.mintick), alert.freq_once_per_bar_close)

// 固定止損 + 止盈 (OCO)
if strategy.position_size > 0
    strategy.exit("L-exit", from_entry = "L", stop = stopPx, limit = tpPx)
if strategy.position_size < 0
    strategy.exit("S-exit", from_entry = "S", stop = stopPx, limit = tpPx)

// 移動出場：收盤跌破 (多) / 站回 (空) 中線
var int belowCnt = 0
var int aboveCnt = 0
belowCnt := close < basis ? belowCnt + 1 : 0
aboveCnt := close > basis ? aboveCnt + 1 : 0

if midExit and strategy.position_size > 0 and belowCnt >= midBars
    strategy.close("L", comment = "跌破EMA9")
    alert("EMA9-BW 平多 " + syminfo.ticker + " 收盤跌破 EMA9", alert.freq_once_per_bar_close)
if midExit and strategy.position_size < 0 and aboveCnt >= midBars
    strategy.close("S", comment = "站回EMA9")
    alert("EMA9-BW 平空 " + syminfo.ticker + " 收盤站回 EMA9", alert.freq_once_per_bar_close)

// ───────────────────────────── 繪圖 ─────────────────────────────
pB = plot(basis, "EMA9 中線", color = color.new(color.orange, 0), linewidth = 2)
pU = plot(upper, "上軌", color = color.new(color.teal, 55), linewidth = 1)
pL = plot(lower, "下軌", color = color.new(color.teal, 55), linewidth = 1)
fill(pU, pL, color = squeeze ? color.new(color.yellow, 88) : color.new(color.teal, 96), title = "通道 (黃 = 擠壓)")
plot(ema21, "EMA21 (趨勢過濾)", color = color.new(color.gray, 20), linewidth = 3)
plot(bw, "Band Width %", color = color.purple, display = display.data_window)
plot(bwLow, "Band Width N 期最低", color = color.gray, display = display.data_window)

plotshape(longSig,  "做多訊號", shape.triangleup,   location.belowbar, color.green, size = size.small, text = "多")
plotshape(shortSig, "做空訊號", shape.triangledown, location.abovebar, color.red,   size = size.small, text = "空")
plot(strategy.position_size != 0 ? stopPx : na, "止損線", color = color.red,   style = plot.style_linebr, linewidth = 1)
plot(strategy.position_size != 0 ? tpPx   : na, "止盈線", color = color.green, style = plot.style_linebr, linewidth = 1)

// 狀態面板
var tbl = table.new(position.top_right, 2, 6, border_width = 1)
if barstate.islast
    table.cell(tbl, 0, 0, "Band Width %", text_size = size.small)
    table.cell(tbl, 1, 0, str.tostring(bw, "#.##"), text_size = size.small)
    table.cell(tbl, 0, 1, "N期最低 BW", text_size = size.small)
    table.cell(tbl, 1, 1, str.tostring(bwLow, "#.##"), text_size = size.small)
    table.cell(tbl, 0, 2, "擠壓中", text_size = size.small)
    table.cell(tbl, 1, 2, squeeze ? "是 ⚠" : (recentSqz ? "剛結束" : "否"), text_size = size.small, bgcolor = squeeze ? color.new(color.yellow, 60) : na)
    table.cell(tbl, 0, 3, "帶寬方向", text_size = size.small)
    table.cell(tbl, 1, 3, expanding ? "擴張 ↑" : "收縮 ↓", text_size = size.small)
    table.cell(tbl, 0, 4, "MACD", text_size = size.small)
    table.cell(tbl, 1, 4, macdL > 0 ? "綠燈" : "紅燈", text_size = size.small, bgcolor = macdL > 0 ? color.new(color.green, 70) : color.new(color.red, 70))
    table.cell(tbl, 0, 5, "EMA9 斜率", text_size = size.small)
    table.cell(tbl, 1, 5, basisUp ? "上升" : (basisDn ? "下降" : "走平"), text_size = size.small)

// 指標式警報 (亦可在警報對話框直接選用)
alertcondition(longSig,  "EMA9-BW 做多訊號", "{{ticker}} EMA9 帶寬策略做多訊號 @{{close}}")
alertcondition(shortSig, "EMA9-BW 做空訊號", "{{ticker}} EMA9 帶寬策略做空訊號 @{{close}}")
alertcondition(squeeze and not squeeze[1], "EMA9-BW 擠壓開始", "{{ticker}} 帶寬進入擠壓，留意突破")
